# SGB Dashboard — env (JANGAN commit file .env asli)
# Copy ke .env lalu isi. Secret HANYA di Coolify Environment Variables saat deploy.

# MySQL (container sendiri di project agency-beriklan)
DATABASE_URL=mysql://sgb:CHANGE_ME@mysql:3306/sgb_dashboard

# URL publik app (untuk CSRF check + link email)
APP_URL=https://sgb.beriklan.co.id

# Seed superadmin (dipakai scripts/seed.ts sekali)
SEED_ADMIN_EMAIL=bos@beriklan.co.id
SEED_ADMIN_PASSWORD=CHANGE_ME_MIN_12_CHAR

# Tenant pertama (Sari Glass)
SEED_TENANT_SLUG=sariglass
SEED_TENANT_NAME=Sari Glass Bangunan
SEED_TENANT_DOMAIN=sgb.beriklan.co.id
# generate: openssl rand -hex 32
SEED_TENANT_INGEST_KEY=CHANGE_ME_64_HEX
