{
  "name": "sgb-dashboard",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Beriklan agency + client dashboard (sgb.beriklan.co.id). Astro 7 SSR + Svelte 5 + Tailwind 4 + Drizzle MySQL. Deploy: Coolify VPS project agency-beriklan.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4323 --host 127.0.0.1",
