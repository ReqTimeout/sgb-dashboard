    "preview": "astro preview --port 4323",
    "check": "astro check",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/inter": "^5.3.0",
