    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lucide/svelte": "^1.45.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "layerchart": "^2.5.0",
    "mysql2": "^3.15.0",
    "nodemailer": "^10.0.10",
    "svelte": "^5.57.0",
