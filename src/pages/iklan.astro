---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import Chart from "../components/Chart.svelte";
import { getRequestTenant, latestMetric, series, sumRange } from "../lib/data";
import { fmtInt, fmtNum, fmtRp } from "../lib/insights";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

async function ch(channel: string) {
  const spend = await series(tenant!.id, channel, "spend", 30);
  const clicks = await series(tenant!.id, channel, "clicks", 30);
  const leads = await series(tenant!.id, channel, channel === "google_ads" ? "conversions" : "leads", 30);
  const s = sumRange(spend, 30, 0), c = sumRange(clicks, 30, 0), l = sumRange(leads, 30, 0);
  return { spend: s, clicks: Math.round(c), leads: Math.round(l), series: spend };
}
const meta = await ch("meta_ads");
const google = await ch("google_ads");
const hasAny = meta.spend + google.spend + meta.clicks + google.clicks > 0;

function cpa(spend: number, leads: number): string {
  if (!leads) return "—";
  return "Rp" + fmtInt(spend / leads);
}
const dates = meta.series.length ? meta.series.map((p) => p.date.slice(5)) : google.series.map((p) => p.date.slice(5));
const option = {
  tooltip: { trigger: "axis" },
  legend: { data: ["Meta spend", "Google spend"], top: 0 },
  grid: { left: 48, right: 12, top: 36, bottom: 28 },
  xAxis: { type: "category", data: dates, axisLabel: { hideOverlap: true } },
  yAxis: { type: "value", name: "Rp" },
  series: [
    { name: "Meta spend", type: "bar", data: meta.series.map((p) => p.value), itemStyle: { color: "#0081fb" } },
    { name: "Google spend", type: "bar", data: google.series.map((p) => p.value), itemStyle: { color: "#fabb05" } },
  ],
};
---
<Base title="Iklan" tenantName={tenant.name}>
  <p class="text-sm text-[color:var(--text-muted)]">{tenant.name} · spend & hasil per channel, 30 hari. Data read-only dari API resmi.</p>

  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <StatCard label="Total spend 30 hari" value={fmtRp(meta.spend + google.spend)} spark={meta.series.slice(-14).map((p) => p.value)} />
    <StatCard label="Meta" value={fmtRp(meta.spend)} hint={`${fmtInt(meta.leads)} lead · CPA ${cpa(meta.spend, meta.leads)}`} warn={meta.leads > 0 && meta.spend / meta.leads > 500000} />
    <StatCard label="Google" value={fmtRp(google.spend)} hint={`${fmtInt(google.leads)} konv · CPA ${cpa(google.spend, google.leads)}`} />
    <StatCard label="Klik iklan 30 hari" value={fmtInt(meta.clicks + google.clicks)} />
  </div>

  <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-4">
    <h2 class="font-heading font-bold">Spend harian</h2>
    {hasAny ? <Chart option={option} client:load /> : <p class="py-8 text-center text-sm text-slate-400">Belum ada spend — campaign P9 belum jalan. Producer sudah siap, data mengalir otomatis saat ada spend.</p>}
  </div>
</Base>
