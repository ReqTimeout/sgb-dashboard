---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import { getRequestTenant, latestMetric, series, sumRange } from "../lib/data";
import { delta, fmtInt, fmtNum, greet, insightClicks } from "../lib/insights";
import { and, eq, gte, sql } from "drizzle-orm";
import { getDb } from "../lib/db";
import { leadEvents } from "../../drizzle/schema";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

const clicks = await series(tenant.id, "seo", "clicks", 30);
const impr = await series(tenant.id, "seo", "impressions", 30);
// GSC delay ~2 hari → 7 hari terakhir yang ada datanya = H-8..H-2
const sum7 = sumRange(clicks, 8, 2);
const prev7 = sumRange(clicks, 15, 9);
const imp7 = sumRange(impr, 8, 2);
const d = delta(sum7, prev7);
const pub = await latestMetric(tenant.id, "content", "articles_published_total");
const leads = await latestMetric(tenant.id, "wa", "leads");
const hasData = clicks.length > 0;
const sparkClicks = clicks.slice(-14).map((p) => p.value);
const sparkImpr = impr.slice(-14).map((p) => p.value);

// Lead per hari 14 hari terakhir (untuk sparkline)
const db = getDb();
const since14 = new Date();
since14.setUTCDate(since14.getUTCDate() - 14);
const leadDaily = await db
  .select({ day: sql<string>`DATE(${leadEvents.ts})`, n: sql<number>`COUNT(*)` })
  .from(leadEvents)
  .where(and(eq(leadEvents.tenantId, tenant.id), gte(leadEvents.ts, since14)))
  .groupBy(sql`DATE(${leadEvents.ts})`)
  .orderBy(sql`DATE(${leadEvents.ts})`);
const leadMap = new Map(leadDaily.map((r) => [String(r.day).slice(0, 10), Number(r.n)]));
const sparkLeads: number[] = [];
for (let i = 13; i >= 0; i--) {
  const dt = new Date();
  dt.setUTCDate(dt.getUTCDate() - i);
  sparkLeads.push(leadMap.get(dt.toISOString().slice(0, 10)) ?? 0);
}
---
<Base title="Pagi ini" tenantName={tenant.name}>
  <div class="card px-5 py-4">
    <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Ringkasan</div>
    <div class="mt-1 font-[family-name:var(--font-display)] text-2xl font-extrabold tracking-tight sm:text-3xl">
      {greet()}, {user.role === "superadmin" ? "Bos" : user.name} 👋
    </div>
    <p class="mt-1 text-sm text-[color:var(--text-muted)]">
      {tenant.name} · {hasData ? insightClicks(sum7, prev7, tenant.name) : "Menunggu data GSC pertama (push harian 05:00 WIB)."}
    </p>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <StatCard label="Klik Google /7 hari" value={fmtInt(sum7)} delta={d.pct ?? undefined} spark={sparkClicks} />
    <StatCard label="Tayang /7 hari" value={fmtNum(imp7)} hint="kali toko tampil di hasil pencarian" spark={sparkImpr} />
    <StatCard label="Artikel terbit" value={pub ? fmtInt(pub.value) : "—"} hint="total di mesin konten" />
    <StatCard label="Lead WA /14 hari" value={leads ? fmtInt(leads.value) : "—"} hint="klik WhatsApp dari web" spark={sparkLeads} />
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    <a href="/seo" class="card p-4"><span class="text-lg">📈</span> <strong class="font-[family-name:var(--font-heading)] text-sm">Performa SEO</strong><br /><span class="text-xs text-[color:var(--text-muted)]">Grafik 90 hari + query & halaman top</span></a>
    <a href="/ranking" class="card p-4"><span class="text-lg">🎯</span> <strong class="font-[family-name:var(--font-heading)] text-sm">Ranking Tracker</strong><br /><span class="text-xs text-[color:var(--text-muted)]">Posisi keyword hari ini + movers</span></a>
    <a href="/konten" class="card p-4"><span class="text-lg">📝</span> <strong class="font-[family-name:var(--font-heading)] text-sm">Content Pipeline</strong><br /><span class="text-xs text-[color:var(--text-muted)]">Draft → terbit → terindex</span></a>
  </div>
</Base>
