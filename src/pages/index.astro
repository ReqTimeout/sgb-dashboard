---
import Base from "../layouts/Base.astro";
import { getRequestTenant, latestMetric, series, sumRange } from "../lib/data";
import { delta, deltaBadge, fmtInt, fmtNum, greet, insightClicks } from "../lib/insights";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

const clicks = await series(tenant.id, "seo", "clicks", 30);
const impr = await series(tenant.id, "seo", "impressions", 30);
// GSC delay ~2 hari → 7 hari terakhir yang ada datanya = H-8..H-2
const sum7 = sumRange(clicks, 8, 2);
const prev7 = sumRange(clicks, 15, 9);
const imp7 = sumRange(impr, 8, 2);
const d = delta(sum7, prev7);
const pub = await latestMetric(tenant.id, "content", "articles_published_total");
const leads = await latestMetric(tenant.id, "wa", "leads");
const hasData = clicks.length > 0;
---
<Base title="Pagi ini">
  <h1 class="font-heading text-2xl font-bold tracking-tight sm:text-3xl">
    {greet()}, {user.role === "superadmin" ? "Bos" : user.name} 👋
  </h1>
  <p class="mt-1 text-sm text-slate-500">
    {tenant.name} · {hasData ? insightClicks(sum7, prev7, tenant.name) : "Menunggu data GSC pertama (push harian 05:00 WIB)."}
  </p>

  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-4">
      <div class="font-mono-num text-3xl font-semibold">{fmtInt(sum7)}</div>
      <div class="mt-1 font-heading text-sm font-bold">Klik Google <span class="font-body font-normal text-slate-400">/7 hari</span></div>
      <div class="mt-1"><Fragment set:html={deltaBadge(d)} /></div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4">
      <div class="font-mono-num text-3xl font-semibold">{fmtNum(imp7)}</div>
      <div class="mt-1 font-heading text-sm font-bold">Tayang <span class="font-body font-normal text-slate-400">/7 hari</span></div>
      <div class="mt-1 text-xs text-slate-400">kali toko tampil di hasil pencarian</div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4">
      <div class="font-mono-num text-3xl font-semibold">{pub ? fmtInt(pub.value) : "—"}</div>
      <div class="mt-1 font-heading text-sm font-bold">Artikel terbit</div>
      <div class="mt-1 text-xs text-slate-400">total di mesin konten</div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4">
      <div class="font-mono-num text-3xl font-semibold">{leads ? fmtInt(leads.value) : "—"}</div>
      <div class="mt-1 font-heading text-sm font-bold">Lead WA</div>
      <div class="mt-1 text-xs text-slate-400">klik WhatsApp dari web</div>
    </div>
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    <a href="/seo" class="rounded-2xl border border-slate-200 bg-white p-4 hover:shadow-md">📈 <strong>Performa SEO</strong><br /><span class="text-sm text-slate-500">Grafik 90 hari + query & halaman top</span></a>
    <a href="/ranking" class="rounded-2xl border border-slate-200 bg-white p-4 hover:shadow-md">🎯 <strong>Ranking Tracker</strong><br /><span class="text-sm text-slate-500">Posisi keyword hari ini + movers</span></a>
    <a href="/konten" class="rounded-2xl border border-slate-200 bg-white p-4 hover:shadow-md">📝 <strong>Content Pipeline</strong><br /><span class="text-sm text-slate-500">Draft → terbit → terindex</span></a>
  </div>
</Base>
