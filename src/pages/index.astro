---
import Base from "../layouts/Base.astro";
import { resolveTenant } from "../lib/tenant";

const user = Astro.locals.user!;
const tenant = await resolveTenant(Astro.url.host, Astro.url.pathname).catch(() => null);
const hour = new Date().getHours();
const greet = hour < 11 ? "Selamat pagi" : hour < 15 ? "Selamat siang" : hour < 19 ? "Selamat sore" : "Selamat malam";

const cards = [
  { label: "Klik Google", value: "—", note: "live di P1 (GSC)" },
  { label: "Lead WA", value: "—", note: "live di P2 (CAPI)" },
  { label: "Artikel baru", value: "—", note: "live di P1 (pipeline)" },
  { label: "URL terindex", value: "—", note: "live di P1 (GSC)" },
];
---
<Base title="Overview">
  <h1 class="font-heading text-2xl font-bold tracking-tight sm:text-3xl">
    {greet}, {user.role === "superadmin" ? "Bos" : user.name} 👋
  </h1>
  <p class="mt-1 text-sm text-slate-500">
    Tenant: <strong>{tenant ? `${tenant.name} (${tenant.slug})` : "— (superadmin, semua tenant)"}</strong>
    · Skeleton P0 — kartu di bawah terisi data live mulai P1.
  </p>

  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {cards.map((c) => (
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_1px_2px_rgba(15,23,42,.06)]">
        <div class="font-mono-num text-3xl font-semibold">{c.value}</div>
        <div class="mt-1 font-heading text-sm font-bold">{c.label}</div>
        <div class="text-xs text-slate-400">{c.note}</div>
      </div>
    ))}
  </div>

  <div class="mt-6 rounded-2xl border-2 border-dashed border-slate-200 bg-white p-6 text-sm text-slate-500">
    <strong class="font-heading text-slate-700">Selanjutnya (WORK-PHASES):</strong>
    <ol class="mt-2 list-decimal space-y-1 pl-5">
      <li>P1 — ingest GSC + halaman SEO live (C1–C4, C11)</li>
      <li>P3 — CAPI gateway → lead WA real-time (C5)</li>
      <li>P4 — daily email 06:45 + arsip laporan + agent memory</li>
    </ol>
  </div>
</Base>
