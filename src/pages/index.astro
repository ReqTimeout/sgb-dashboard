---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import AreaChartLC from "../components/AreaChartLC.svelte";
import CopilotWidget from "../components/CopilotWidget.svelte";
import { getRequestTenant, latestMetric, series, sumRange } from "../lib/data";
import { delta, fmtInt, fmtNum, fmtRp, greet } from "../lib/insights";
import { and, eq, gte, sql } from "drizzle-orm";
import { getDb } from "../lib/db";
import { leadEvents } from "../../drizzle/schema";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

const clicks = await series(tenant.id, "seo", "clicks", 30);
const impr = await series(tenant.id, "seo", "impressions", 30);
const sum7 = sumRange(clicks, 8, 2);
const prev7 = sumRange(clicks, 15, 9);
const imp7 = sumRange(impr, 8, 2);
const sum30 = sumRange(clicks, 30, 0);
const imp30 = sumRange(impr, 30, 0);
const d = delta(sum7, prev7);
const pub = await latestMetric(tenant.id, "content", "articles_published_total");
const pub24 = await latestMetric(tenant.id, "content", "articles_published_24h");
const leads = await latestMetric(tenant.id, "wa", "leads");
const mSpend7 = sumRange(await series(tenant.id, "meta_ads", "spend", 10), 8, 2);
const mChats7 = sumRange(await series(tenant.id, "meta_ads", "leads", 10), 8, 2);
const gSpend7 = sumRange(await series(tenant.id, "google_ads", "spend", 10), 8, 2);
const staleCut = new Date(Date.now() - 12 * 3600 * 1000);
const staleOldQ = await getDb()
  .select({ id: leadEvents.id, ts: leadEvents.ts })
  .from(leadEvents)
  .where(and(eq(leadEvents.tenantId, tenant.id), eq(leadEvents.status, "baru")))
  .orderBy(sql`ts DESC`)
  .limit(100);
const staleOldN = staleOldQ.filter((r) => new Date(r.ts).getTime() < staleCut.getTime()).length;

// Strip kesehatan semua channel (satu pandang: sehat / perlu perhatian)
const mCpa7 = mChats7 > 0 ? mSpend7 / mChats7 : 0;
const channels = [
  { href: "/seo", label: "SEO", ok: sum7 > 0, warn: (d.pct ?? 0) < -10, note: sum7 > 0 ? `${fmtInt(sum7)} klik/7h` : "belum ada klik" },
  { href: "/iklan", label: "Meta", ok: mSpend7 > 0, warn: mCpa7 > 15000, note: mSpend7 > 0 ? `${fmtRp(mCpa7)}/chat` : "tidak ada spend" },
  { href: "/iklan", label: "Google", ok: gSpend7 > 0, warn: false, note: gSpend7 > 0 ? `${fmtRp(gSpend7)}/7h` : "belum jalan (P9)" },
  { href: "/leads", label: "WA", ok: staleOldN === 0, warn: staleOldN > 0, note: staleOldN > 0 ? `${staleOldN} mendesak` : "pipeline bersih" },
  { href: "/konten", label: "Konten", ok: (pub?.value ?? 0) > 0, warn: false, note: pub24?.value ? `+${fmtInt(pub24.value)} kemarin` : `${fmtInt(pub?.value ?? 0)} total` },
];
const hasData = clicks.length > 0;
const sparkClicks = clicks.slice(-14).map((p) => p.value);
const sparkImpr = impr.slice(-14).map((p) => p.value);

const db = getDb();
const since14 = new Date();
since14.setUTCDate(since14.getUTCDate() - 14);
const leadDaily = await db
  .select({ day: sql<string>`DATE(${leadEvents.ts})`, n: sql<number>`COUNT(*)` })
  .from(leadEvents)
  .where(and(eq(leadEvents.tenantId, tenant.id), gte(leadEvents.ts, since14)))
  .groupBy(sql`DATE(${leadEvents.ts})`)
  .orderBy(sql`DATE(${leadEvents.ts})`);
const leadMap = new Map(leadDaily.map((r) => [String(r.day).slice(0, 10), Number(r.n)]));
const sparkLeads: number[] = [];
for (let i = 13; i >= 0; i--) {
  const dt = new Date();
  dt.setUTCDate(dt.getUTCDate() - i);
  sparkLeads.push(leadMap.get(dt.toISOString().slice(0, 10)) ?? 0);
}

// Savings: kalau organik menghasilkan X klik, dan CPC Meta ~Rp1.000,
// berarti Anda "hemat" Rp Xjt yang tidak perlu dibayar ke Meta bulan ini.
const organicClickValue = sum7 * 1000; // estimasi nilai SEO vs paid Meta
const trend7 = d.pct ?? 0;
const headline = hasData
  ? `${fmtInt(sum7)} klik Google 7 hari terakhir — ${trend7 > 0 ? `naik ${Math.abs(trend7).toFixed(0)}%` : trend7 < 0 ? `turun ${Math.abs(trend7).toFixed(0)}%` : "stabil"} vs minggu lalu.`
  : `Belum ada data GSC untuk 7 hari terakhir.`;
---
<Base title="Pagi ini" tenantName={tenant.name}>
  <!-- HERO WOW -->
  <div class="relative overflow-hidden rounded-2xl px-6 py-7 grain" style="background: linear-gradient(135deg, #1C1917 0%, #292524 100%); color: #fff;">
    <div class="hazard-stripe absolute inset-x-0 top-0"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-24 h-72 w-72 rounded-full" style="background: radial-gradient(circle, rgb(37 211 102 / 0.20), transparent 70%)"></div>
    <div class="pointer-events-none absolute -top-24 -left-24 h-64 w-64 rounded-full" style="background: radial-gradient(circle, rgb(220 38 38 / 0.20), transparent 70%)"></div>
    <div class="relative z-10 grid gap-5 sm:grid-cols-[1fr_auto] sm:items-end">
      <div>
        <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#FACC15]">{greet()}, {user.role === "superadmin" ? "Pak Bos" : "Ibu"} 👋</div>
        <div class="mt-2 text-display text-3xl sm:text-5xl">{tenant.name}</div>
        <p class="mt-3 max-w-xl text-base text-white/85">{headline}</p>
      </div>
      <div class="grid gap-2 sm:gap-3">
        <div class="rounded-xl border border-white/15 px-4 py-3">
          <div class="text-[10px] text-white/55 uppercase tracking-[0.12em]">Hemat dari organik 7 hari</div>
          <div class="font-[family-name:var(--font-display)] text-3xl font-extrabold text-[#34d399]">{fmtRp(organicClickValue)}</div>
          <div class="text-[10px] text-white/55">≈ setara biaya Meta untuk klik yg sama</div>
        </div>
        <div class="rounded-xl border border-white/15 px-4 py-3">
          <div class="text-[10px] text-white/55 uppercase tracking-[0.12em]">Tayang 7 hari</div>
          <div class="font-[family-name:var(--font-display)] text-3xl font-extrabold">{fmtNum(imp7)}</div>
          <div class="text-[10px] text-white/55">kali muncul di Google</div>
        </div>
      </div>
    </div>
  </div>

  <!-- STRIP KESEHATAN SEMUA CHANNEL -->
  <div class="card mt-4 px-4 py-3">
    <div class="flex items-center gap-2 overflow-x-auto">
      <span class="shrink-0 text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Channel</span>
      {channels.map((c) => (
        <a href={c.href} class="flex shrink-0 items-center gap-1.5 rounded-full border border-[color:var(--border-subtle)] px-2.5 py-1 text-xs transition-all hover:-translate-y-px hover:shadow-[var(--shadow-card)]">
          <span class="h-1.5 w-1.5 rounded-full" style={`background:${!c.ok ? "var(--text-faint)" : c.warn ? "var(--warning)" : "var(--success)"}`}></span>
          <strong>{c.label}</strong>
          <span class="text-[color:var(--text-muted)]">{c.note}</span>
        </a>
      ))}
    </div>
  </div>

  <!-- WOW 4 KARTU -->
  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <StatCard label="Klik Google /7 hari" value={fmtInt(sum7)} delta={d.pct ?? undefined} spark={sparkClicks} />
    <StatCard label="Tayang /7 hari" value={fmtNum(imp7)} hint="kali muncul di hasil pencarian" spark={sparkImpr} />
    <StatCard label="Artikel terbit" value={pub ? fmtInt(pub.value) : "—"} hint={`${fmtInt(pub?.value ?? 0)} artikel live di Google`} />
    <StatCard label="Lead WA /14 hari" value={leads ? fmtInt(leads.value) : "—"} hint="klik WhatsApp dari web" spark={sparkLeads} />
  </div>

  <!-- AI COPILOT WIDGET (live data → 3 aksi spesifik) -->
  <div class="card mt-4 p-5">
    <CopilotWidget client:load />
  </div>

  <!-- INSIGHT NARATIF (3 kalimat human) -->
  <div class="card mt-4 p-5">
    <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Insight minggu ini</div>
    <div class="mt-2 grid gap-3 sm:grid-cols-3 text-sm leading-relaxed">
      <p class="rounded-lg bg-[color:var(--bg-surface-2)]/60 p-3">
        <strong class="text-[color:var(--text-primary)]">Sampeyan, SEO Anda jalan.</strong>{" "}
        <span class="text-[color:var(--text-secondary)]">
          {sum30 > 0
            ? `${fmtInt(sum30)} klik masuk dari Google 30 hari terakhir. Kalau pakai iklan, ini setara sekitar ${fmtRp(sum30 * 1500)} budget.`
            : "Belum ada klik 30 hari — biasanya perlu 1-2 minggu setelah push GSC pertama."}
        </span>
      </p>
      <p class="rounded-lg bg-[color:var(--bg-surface-2)]/60 p-3">
        <strong class="text-[color:var(--text-primary)]">Mesin konten tidak diam.</strong>{" "}
        <span class="text-[color:var(--text-secondary)]">
          {pub?.value
            ? `Sudah ${fmtInt(pub.value)} artikel live. Tiap artikel baru dapat giliran muncul di Google minggu ini.`
            : "Belum ada artikel yang diterbitkan."}
        </span>
      </p>
      <p class="rounded-lg bg-[color:var(--bg-surface-2)]/60 p-3">
        <strong class="text-[color:var(--text-primary)]">Lead WA jalan terus.</strong>{" "}
        <span class="text-[color:var(--text-secondary)]">
          {leads?.value
            ? `${fmtInt(leads.value)} klik WA masuk 14 hari terakhir. Tertinggi biasanya Senin-Sabtu malam.`
            : "Belum ada lead WA — halaman ini terisi otomatis dari klik tombol WhatsApp di situs."}
        </span>
      </p>
    </div>
  </div>

  <!-- CHART TREN 30 HARI (LayerChart) -->
  <div class="card mt-4 overflow-hidden">
    <div class="flex items-center justify-between border-b border-[color:var(--border-subtle)] px-5 py-3">
      <div>
        <h2 class="font-[family-name:var(--font-heading)] text-sm font-bold">Tren 30 hari</h2>
        <p class="text-[10px] text-[color:var(--text-faint)]">Klik merah = masuk dari Google · Klik hijau = lead WA dari situs</p>
      </div>
      <span class="chip text-[10px]">{clicks.length} hari</span>
    </div>
    <div class="p-4">
      {clicks.length > 0 ? (
        <div class="grid gap-3 lg:grid-cols-2">
          <div>
            <div class="mb-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Klik Google</div>
            <AreaChartLC data={clicks.slice(-30)} height={160} />
          </div>
          <div>
            <div class="mb-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Lead WhatsApp</div>
            <AreaChartLC data={sparkLeads.map((v, i) => ({ date: sparkLeads.length > 0 ? `d${i}` : `d${i}`, value: v }))} height={160} />
          </div>
        </div>
      ) : (
        <p class="py-8 text-center text-sm text-[color:var(--text-faint)]">Belum ada data — push GSC pertama jalan 05:00 WIB.</p>
      )}
    </div>
  </div>

  <!-- DEEP LINK NAVIGATION -->
  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    <a href="/seo" class="card p-4"><span class="text-lg">📈</span> <strong class="font-[family-name:var(--font-heading)] text-sm">Performa SEO</strong><br /><span class="text-xs text-[color:var(--text-muted)]">Grafik 90 hari + query & halaman top</span></a>
    <a href="/ranking" class="card p-4"><span class="text-lg">🎯</span> <strong class="font-[family-name:var(--font-heading)] text-sm">Ranking Tracker</strong><br /><span class="text-xs text-[color:var(--text-muted)]">Posisi keyword hari ini + movers</span></a>
    <a href="/konten" class="card p-4"><span class="text-lg">📝</span> <strong class="font-[family-name:var(--font-heading)] text-sm">Content Pipeline</strong><br /><span class="text-xs text-[color:var(--text-muted)]">Draft → terbit → terindex</span></a>
  </div>
</Base>
