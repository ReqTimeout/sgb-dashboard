---
import Base from "../layouts/Base.astro";
import EmptyState from "../components/EmptyState.astro";
import Icon from "../components/Icon.astro";
import { getRequestTenant } from "../lib/data";
import { desc, eq } from "drizzle-orm";
import { getDb } from "../lib/db";
import { dailyReports } from "../../drizzle/schema";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

const db = getDb();
const rows = await db
  .select()
  .from(dailyReports)
  .where(eq(dailyReports.tenantId, tenant.id))
  .orderBy(desc(dailyReports.reportDate))
  .limit(30);

function num(p: unknown, k: string): string {
  const v = (p as Record<string, unknown> | null)?.[k];
  return typeof v === "number" ? new Intl.NumberFormat("id-ID").format(Math.round(v)) : "—";
}
function pct(p: unknown, k: string): string {
  const v = (p as Record<string, unknown> | null)?.[k];
  if (typeof v !== "number") return "—";
  const sign = v > 0 ? "▲" : v < 0 ? "▼" : "·";
  const cls = v > 0 ? "chip-success" : v < 0 ? "chip-danger" : "chip";
  return `<span class="chip ${cls} text-[10px]">${sign}${Math.abs(v).toFixed(0)}%</span>`;
}
const totalSent = rows.filter((r) => r.emailSentAt).length;
const totalErr = rows.reduce((a, r) => a + Number(((r.payloadJson as Record<string, unknown> | null)?.cron_err) ?? 0), 0);

// Filter periode (chips UI) — 7 / 30 / 90 hari terakhir.
const selectedPeriod = Astro.url.searchParams.get("period") ?? "30";
const periodDays = selectedPeriod === "7" ? 7 : selectedPeriod === "90" ? 90 : 30;
const filteredRows = rows.slice(0, periodDays);
---
<Base title="Arsip Laporan" tenantName={tenant.name}>
  <div class="relative overflow-hidden rounded-2xl border border-[color:var(--border-subtle)] px-6 py-5 grain" style="background: linear-gradient(135deg, #1C1917 0%, #292524 100%); color: #fff;">
    <div class="hazard-stripe absolute inset-x-0 top-0"></div>
    <div class="relative z-10 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
      <div>
        <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#FACC15]">Arsip Laporan · semua email pagi</div>
        <div class="mt-1 text-display text-3xl sm:text-4xl">Laporan otomatis<br /><span style="color:#FACC15">tiap pagi, bisa dibuka kapanpun.</span></div>
        <p class="mt-2 max-w-md text-sm text-white/70">Setiap email 06:45 WIB tersimpan di sini — tidak perlu cari-cari inbox. Klik tanggal untuk buka detail.</p>
      </div>
      <div class="flex gap-2 text-xs">
        <div class="rounded-lg border border-white/15 px-3 py-2">
          <div class="text-[10px] text-white/50 uppercase tracking-[0.12em]">Total arsip</div>
          <div class="font-[family-name:var(--font-mono-num)] text-2xl font-extrabold count-up">{rows.length}</div>
        </div>
        <div class="rounded-lg border border-white/15 px-3 py-2">
          <div class="text-[10px] text-white/50 uppercase tracking-[0.12em]">Terkirim</div>
          <div class="font-[family-name:var(--font-mono-num)] text-2xl font-extrabold count-up" style="color:#34d399">{totalSent}</div>
        </div>
        <div class="rounded-lg border border-white/15 px-3 py-2">
          <div class="text-[10px] text-white/50 uppercase tracking-[0.12em]">Cron error</div>
          <div class:list={["font-[family-name:var(--font-mono-num)] text-2xl font-extrabold count-up", totalErr > 0 ? "text-[#f87171]" : "text-white/40"]}>{totalErr}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter periode -->
  <div class="mt-4 flex items-center gap-2">
    <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Periode:</span>
    {(["7", "30", "90"] as const).map((p) => (
      <a
        href={`?period=${p}`}
        class:list={[
          "rounded-full border px-3 py-1 text-xs transition-colors",
          periodDays === Number(p)
            ? "border-[color:var(--brand)] bg-[color:var(--brand-soft)] font-bold text-[color:var(--brand)]"
            : "border-[color:var(--border-subtle)] text-[color:var(--text-muted)] hover:border-[color:var(--border-strong)]",
        ]}
      >{p} hari</a>
    ))}
  </div>

  <div class="mt-3 space-y-3">
    {filteredRows.length === 0 && (
      <EmptyState
        title="Belum ada laporan untuk periode ini"
        message="Email harian dari cron daily-report tersimpan di sini setiap pukul 06:45 WIB."
        mascot="peek"
        when="Push pertama biasanya besok pagi (kemarin sudah lewat)."
        action="Email pagi ini akan muncul otomatis — tidak perlu request manual."
      />
    )}
    {filteredRows.map((r) => {
      const p = r.payloadJson as Record<string, unknown> | null;
      const insight = (p?.insight_text as string) ?? "";
      return (
        <details class="card overflow-hidden">
          <summary class="flex cursor-pointer items-center gap-3 px-5 py-4">
            <span class="grid h-10 w-10 place-items-center rounded-lg bg-[color:var(--brand-soft)] text-[color:var(--brand)]">
              <span class="font-[family-name:var(--font-display)] text-[13px] font-extrabold">{String(r.reportDate).slice(8, 10)}</span>
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <strong class="font-[family-name:var(--font-heading)] text-sm">{r.reportDate}</strong>
                <span class="chip text-[10px]">{r.period}</span>
                {r.emailSentAt ? (
                  <span class="chip chip-success inline-flex items-center gap-1 text-[10px]">
                    <Icon name="mail" size="xs" /> terkirim
                  </span>
                ) : (
                  <span class="chip inline-flex items-center gap-1 text-[10px]">
                    <Icon name="doc" size="xs" /> arsip
                  </span>
                )}
                <Fragment set:html={pct(p, "clicks_pct")} />
              </div>
              {insight && <p class="mt-1 line-clamp-2 text-xs text-[color:var(--text-muted)]">{insight}</p>}
            </div>
            <svg class="h-4 w-4 text-[color:var(--text-faint)] transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="border-t border-[color:var(--border-subtle)] bg-[color:var(--bg-surface-2)]/60 px-5 py-4">
            <div class="grid grid-cols-2 gap-2 text-sm sm:grid-cols-4">
              <div class="rounded-lg bg-[color:var(--bg-surface)] p-3"><div class="font-[family-name:var(--font-mono-num)] text-xl font-extrabold">{num(p, "clicks_y")}</div><div class="mt-0.5 text-[10px] uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Klik</div></div>
              <div class="rounded-lg bg-[color:var(--bg-surface)] p-3"><div class="font-[family-name:var(--font-mono-num)] text-xl font-extrabold">{num(p, "articles_new")}</div><div class="mt-0.5 text-[10px] uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Artikel baru</div></div>
              <div class="rounded-lg bg-[color:var(--bg-surface)] p-3"><div class="font-[family-name:var(--font-mono-num)] text-xl font-extrabold">{num(p, "submitted")}</div><div class="mt-0.5 text-[10px] uppercase tracking-[0.12em] text-[color:var(--text-faint)]">URL submit</div></div>
              <div class="rounded-lg bg-[color:var(--bg-surface)] p-3"><div class="font-[family-name:var(--font-mono-num)] text-xl font-extrabold">{num(p, "cron_err")}</div><div class="mt-0.5 text-[10px] uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Cron error</div></div>
            </div>
          </div>
        </details>
      );
    })}
  </div>
</Base>
