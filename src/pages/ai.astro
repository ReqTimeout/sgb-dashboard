---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import { getRequestTenant, latestMetric } from "../lib/data";
import { fmtInt } from "../lib/insights";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

const aiRefs = await latestMetric(tenant.id, "ai", "referrals_7d");
const llmsTxtUrl = "https://sariglassbangunan.com/llms.txt";
const robotsUrl = "https://sariglassbangunan.com/robots.txt";

const items = [
  {
    icon: "📄",
    title: "llms.txt",
    big: "Live",
    sub: "24KB komprehensif (produk, brand, area, artikel, FAQ). Dicek tiap 12 jam oleh cron llm-search-ping.",
    href: llmsTxtUrl,
    hrefLabel: "Lihat file",
    ok: true,
  },
  {
    icon: "🤖",
    title: "Izin crawler AI",
    big: "13/13",
    sub: "GPTBot, OAI-SearchBot, ClaudeBot, PerplexityBot, Google-Extended, Bytespider diizinkan robots.txt.",
    href: robotsUrl,
    hrefLabel: "Cek robots",
    ok: true,
  },
  {
    icon: "🔍",
    title: "IndexNow → Bing",
    big: "Aktif",
    sub: "Submit tiap 2 jam + Bing Webmaster API. ChatGPT Search pakai index Bing — konten baru cepat masuk AI search.",
    ok: true,
  },
  {
    icon: "👥",
    title: "Kunjungan dari AI /7 hari",
    big: aiRefs ? fmtInt(aiRefs.value) : "—",
    sub: aiRefs ? "chatgpt.com, perplexity.ai, claude.ai, copilot, gemini (via GA4)" : "mulai terhitung setelah collector GA4 jalan",
    ok: aiRefs ? Number(aiRefs.value) > 0 : false,
  },
];
---
<Base title="AI Search Visibility" tenantName={tenant.name}>
  <div class="relative overflow-hidden rounded-2xl px-6 py-7 grain" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #fff;">
    <div class="hazard-stripe absolute inset-x-0 top-0"></div>
    <div class="pointer-events-none absolute right-6 top-6 hidden h-32 w-32 rounded-full sm:block" style="background: radial-gradient(circle, rgb(99 102 241 / 0.35), transparent 70%)"></div>
    <div class="relative z-10 max-w-xl">
      <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#A5B4FC]">AI Search Visibility</div>
      <h2 class="mt-2 text-display text-3xl sm:text-4xl">Toko Anda juga<br />ditemukan lewat <span style="color:#A5B4FC">ChatGPT, Perplexity, Gemini.</span></h2>
      <p class="mt-2 text-sm text-white/70">{tenant.name} · infrastruktur AI-search 100% hijau.</p>
    </div>
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    {items.map((it) => (
      <div class="card relative p-5">
        <div class="flex items-start gap-3">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-[color:var(--brand-soft)] text-xl">{it.icon}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-[family-name:var(--font-heading)] text-sm font-bold">{it.title}</span>
              {it.ok && <span class="chip chip-success text-[10px]">✓</span>}
            </div>
            <div class:list={["mt-1 font-[family-name:var(--font-display)] text-2xl font-extrabold", it.ok ? "text-[color:var(--success)]" : "text-[color:var(--text-primary)]"]}>{it.big}</div>
            <p class="mt-1 text-xs text-[color:var(--text-muted)]">{it.sub}</p>
            {it.href && <a class="mt-2 inline-block text-[11px] font-semibold text-[color:var(--info)] hover:underline" href={it.href} target="_blank" rel="noopener">{it.hrefLabel} ↗</a>}
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="card mt-4 p-5">
    <div class="flex items-center gap-3">
      <div class="grid h-10 w-10 place-items-center rounded-xl bg-[color:var(--info-soft)] text-[color:var(--info)]">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      </div>
      <div>
        <div class="font-[family-name:var(--font-heading)] text-sm font-bold">Cek sitasi bulanan</div>
        <p class="mt-0.5 text-xs text-[color:var(--text-muted)]">Agent tanya Perplexity/ChatGPT/Gemini: "toko bahan bangunan majenang" — catat apakah <strong>{tenant.name}</strong> disebut.</p>
      </div>
    </div>
    <p class="mt-3 text-[11px] text-[color:var(--text-faint)]">Jadwal cek berikutnya: awal bulan depan. Roadmap lengkap ada di <code class="rounded bg-[color:var(--bg-surface-2)] px-1">docs/IMPROVEMENT.md §D5.2</code>.</p>
  </div>
</Base>
