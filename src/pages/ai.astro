---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import { getRequestTenant, latestMetric } from "../lib/data";
import { fmtInt } from "../lib/insights";
import { getDb } from "../lib/db";
import { aiCitations } from "../../drizzle/schema";
import { desc, eq } from "drizzle-orm";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

const aiRefs = await latestMetric(tenant.id, "ai", "referrals_7d");
const citations = await getDb()
  .select()
  .from(aiCitations)
  .where(eq(aiCitations.tenantId, tenant.id))
  .orderBy(desc(aiCitations.checkedAt))
  .limit(30);
const llmsTxtUrl = "https://sariglassbangunan.com/llms.txt";
const robotsUrl = "https://sariglassbangunan.com/robots.txt";

// Verifikasi LIVE langsung ke situs (bukan klaim statis)
let llmsSize = 0;
let aiAgents: string[] = [];
try {
  const r1 = await fetch("https://sariglassbangunan.com/llms.txt");
  if (r1.ok) llmsSize = (await r1.text()).length;
  const r2 = await fetch("https://sariglassbangunan.com/robots.txt");
  if (r2.ok) {
    const t = await r2.text();
    const m = t.match(/^User-agent:\s*(\S+)/gim) ?? [];
    aiAgents = [...new Set(m.map((s) => s.replace(/^User-agent:\s*/i, "").trim()))].filter((a) => a !== "*");
  }
} catch { /* offline — tampilkan klaim terakhir */ }

const items = [
  {
    icon: "📄",
    title: "llms.txt",
    big: llmsSize > 0 ? `${(llmsSize / 1024).toFixed(0)}KB live` : "Live",
    sub: llmsSize > 0
      ? `Terverifikasi barusan: ${(llmsSize / 1024).toFixed(1)}KB komprehensif (produk, brand, area, artikel, FAQ). Dicek tiap 12 jam oleh cron llm-search-ping.`
      : "24KB komprehensif (produk, brand, area, artikel, FAQ). Dicek tiap 12 jam oleh cron llm-search-ping.",
    href: llmsTxtUrl,
    hrefLabel: "Lihat file",
    ok: llmsSize > 5000,
  },
  {
    icon: "🤖",
    title: "Izin crawler AI",
    big: aiAgents.length > 0 ? `${aiAgents.length} agen` : "13/13",
    sub: aiAgents.length > 0
      ? `Terverifikasi barusan dari robots.txt: ${aiAgents.slice(0, 8).join(", ")}${aiAgents.length > 8 ? ` +${aiAgents.length - 8} lagi` : ""}.`
      : "GPTBot, OAI-SearchBot, ClaudeBot, PerplexityBot, Google-Extended, Bytespider diizinkan robots.txt.",
    href: robotsUrl,
    hrefLabel: "Cek robots",
    ok: aiAgents.length > 0,
  },
  {
    icon: "🔍",
    title: "IndexNow → Bing",
    big: "Aktif",
    sub: "Submit tiap 2 jam + Bing Webmaster API. ChatGPT Search pakai index Bing — konten baru cepat masuk AI search.",
    ok: true,
  },
  {
    icon: "👥",
    title: "Kunjungan dari AI /7 hari",
    big: aiRefs ? fmtInt(aiRefs.value) : "—",
    sub: aiRefs ? "chatgpt.com, perplexity.ai, claude.ai, copilot, gemini (via GA4)" : "mulai terhitung setelah collector GA4 jalan",
    ok: aiRefs ? Number(aiRefs.value) > 0 : false,
  },
];
---
<Base title="AI Search Visibility" tenantName={tenant.name}>
  <div class="relative overflow-hidden rounded-2xl px-6 py-5 grain" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #fff;">
    <div class="hazard-stripe absolute inset-x-0 top-0"></div>
    <div class="pointer-events-none absolute right-6 top-6 hidden h-32 w-32 rounded-full sm:block" style="background: radial-gradient(circle, rgb(99 102 241 / 0.35), transparent 70%)"></div>
    <div class="relative z-10 max-w-xl">
      <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#A5B4FC]">AI Search Visibility</div>
      <h2 class="mt-2 text-display text-3xl sm:text-4xl">Toko Anda juga<br />ditemukan lewat <span style="color:#A5B4FC">ChatGPT, Perplexity, Gemini.</span></h2>
      <p class="mt-2 text-sm text-white/70">{tenant.name} · infrastruktur AI-search 100% hijau.</p>
    </div>
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    {items.map((it) => (
      <div class="card relative p-5">
        <div class="flex items-start gap-3">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-[color:var(--brand-soft)] text-xl">{it.icon}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-[family-name:var(--font-heading)] text-sm font-bold">{it.title}</span>
              {it.ok && <span class="chip chip-success text-[10px]">✓</span>}
            </div>
            <div class:list={["mt-1 font-[family-name:var(--font-display)] text-2xl font-extrabold", it.ok ? "text-[color:var(--success)]" : "text-[color:var(--text-primary)]"]}>{it.big}</div>
            <p class="mt-1 text-xs text-[color:var(--text-muted)]">{it.sub}</p>
            {it.href && <a class="mt-2 inline-block text-[11px] font-semibold text-[color:var(--info)] hover:underline" href={it.href} target="_blank" rel="noopener">{it.hrefLabel} ↗</a>}
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="card mt-4 p-5">
    <div class="flex items-center gap-3">
      <div class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[color:var(--info-soft)] text-[color:var(--info)]">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      </div>
      <div class="flex-1">
        <div class="font-[family-name:var(--font-heading)] text-sm font-bold">Sitasi di jawaban AI <span class="font-[family-name:var(--font-body)] text-xs font-normal text-[color:var(--text-faint)]">apakah {tenant.name} disebut ChatGPT/Perplexity/Gemini</span></div>
        <p class="mt-0.5 text-xs text-[color:var(--text-muted)]">Pengecekan manual tiap awal bulan (5 query × 3 mesin). Hasil tercatat di bawah sebagai tren.</p>
      </div>
      <span class="chip text-[10px]">{citations.length} cek</span>
    </div>
    {citations.length === 0 ? (
      <div class="mt-3 rounded-lg bg-[color:var(--bg-surface-2)]/60 p-4 text-sm text-[color:var(--text-muted)]">
        Belum ada hasil cek. Cek pertama dijadwalkan awal bulan depan — lima query lokal diuji di tiga mesin AI, hasilnya tampil di sini per mesin.
      </div>
    ) : (
      <div class="mt-3">
        <div class="grid grid-cols-3 gap-2">
          {["perplexity", "chatgpt", "gemini"].map((e) => {
            const rows = citations.filter((c) => c.engine === e);
            const hit = rows.filter((c) => c.mentioned).length;
            return (
              <div class="rounded-lg bg-[color:var(--bg-surface-2)]/60 p-3 text-center">
                <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">{e}</div>
                <div class={`mt-1 font-[family-name:var(--font-display)] text-2xl font-extrabold ${rows.length && hit === rows.length ? "text-[color:var(--success)]" : hit > 0 ? "text-[color:var(--warning)]" : ""}`}>{rows.length ? `${hit}/${rows.length}` : "—"}</div>
                <div class="text-[10px] text-[color:var(--text-muted)]">disebut</div>
              </div>
            );
          })}
        </div>
        <table class="mt-3 w-full text-sm">
          <tbody>
            {citations.slice(0, 10).map((c) => (
              <tr class="border-t border-[color:var(--border-subtle)]">
                <td class="py-2 pr-2">{c.query}</td>
                <td class="py-2 text-[11px] text-[color:var(--text-faint)]">{c.engine}</td>
                <td class="py-2 text-right">{c.mentioned ? <span class="chip chip-success text-[10px]">disebut{c.position ? ` #${c.position}` : ""}</span> : <span class="chip text-[10px]">tidak</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</Base>
