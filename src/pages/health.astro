---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import { getRequestTenant, latestMetric } from "../lib/data";
import { fmtInt } from "../lib/insights";

const user = Astro.locals.user!;
if (user.role !== "superadmin") throw new Error("Khusus agency");
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, true);
if (!tenant) throw new Error("Tenant tidak ditemukan");

const okRuns = await latestMetric(tenant.id, "system", "cron_ok_24h");
const errRuns = await latestMetric(tenant.id, "system", "cron_err_24h");
const pending = await latestMetric(tenant.id, "seo", "indexing_pending");
const healthy = (errRuns?.value ?? 0) === 0;

// Status REAL per-cron dari admin (run terakhir + error asli)
let liveCrons: { name: string; started_at: string; ok: boolean; error: string | null; summary: unknown }[] = [];
let liveOk = false;
try {
  const adminUrl = (process.env.ADMIN_URL ?? "https://admin.sariglassbangunan.com").replace(/\/$/, "");
  const adminToken = process.env.ADMIN_CRON_TOKEN ?? "";
  const r = await fetch(`${adminUrl}/api/audit/crons?token=${encodeURIComponent(adminToken)}`);
  if (r.ok) {
    const j = await r.json();
    liveCrons = j.crons ?? [];
    liveOk = true;
  }
} catch { /* admin down — pakai daftar statis */ }
const liveMap = new Map(liveCrons.map((c) => [c.name, c]));

const crons = [
  { name: "publish-articles", time: "06:00", role: "terbit" },
  { name: "seo-publish-pipeline", time: "06:15", role: "commit" },
  { name: "sitemap-ping", time: "06:30", role: "ping" },
  { name: "daily-report", time: "06:45", role: "email" },
  { name: "gsc-indexing", time: "30m", role: "index" },
  { name: "indexnow", time: "2h", role: "index" },
  { name: "gsc-url-inspection", time: "6h", role: "audit" },
  { name: "llm-search-ping", time: "12h", role: "ai" },
  { name: "health-check", time: "1h", role: "audit" },
  { name: "weekly-report", time: "Senin 07:00", role: "email" },
  { name: "push-metrics", time: "05:00", role: "collector" },
  { name: "meta-insights", time: "05:30", role: "ads" },
  { name: "google-insights", time: "05:35", role: "ads" },
  { name: "keyword-snapshot", time: "05:10", role: "seo" },
  { name: "keyword-harvester", time: "Senin 08:10", role: "seo" },
  { name: "lead-reminder", time: "07:00", role: "pipeline" },
];
const roleColor: Record<string, string> = {
  terbit: "var(--success)", commit: "var(--info)", ping: "var(--text-muted)", email: "var(--warning)",
  index: "var(--info)", audit: "var(--text-muted)", ai: "var(--brand)", collector: "var(--text-secondary)",
  ads: "var(--brand)", seo: "var(--info)", pipeline: "var(--warning)",
};
---
<Base title="System Health" tenantName="Agency">
  <div class:list={["relative overflow-hidden rounded-2xl px-6 py-5 grain", healthy ? "" : ""]} style={healthy ? "background: linear-gradient(135deg, #064E3B 0%, #065F46 100%); color: #fff;" : "background: linear-gradient(135deg, #7F1D1D 0%, #991B1B 100%); color: #fff;"}>
    <div class="hazard-stripe absolute inset-x-0 top-0"></div>
    <div class="relative z-10 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
      <div>
        <div class="flex items-center gap-2">
          <span class="pulse-dot" style={healthy ? "background:#34d399" : "background:#fbbf24"}></span>
          <span class="text-[10px] font-semibold uppercase tracking-[0.14em]" style={healthy ? "color:#A7F3D0" : "color:#FED7AA"}>{healthy ? "Semua sistem normal" : "Ada yang perlu dicek"}</span>
        </div>
        <div class="mt-2 text-display text-4xl sm:text-5xl">{healthy ? "SEHAT" : "PERIKSA"}</div>
        <p class="mt-2 text-sm text-white/70">{fmtInt(okRuns?.value)} run OK · {fmtInt(errRuns?.value)} error /24 jam</p>
      </div>
      <div class="flex gap-2 text-xs">
        <div class="rounded-lg border border-white/15 px-3 py-2"><div class="text-[10px] text-white/50 uppercase tracking-[0.12em]">Antre index</div><div class="font-[family-name:var(--font-mono-num)] text-2xl font-extrabold count-up">{pending ? fmtInt(pending.value) : "—"}</div></div>
        <div class="rounded-lg border border-white/15 px-3 py-2"><div class="text-[10px] text-white/50 uppercase tracking-[0.12em]">Cron</div><div class="font-[family-name:var(--font-mono-num)] text-2xl font-extrabold count-up">{crons.length}</div></div>
      </div>
    </div>
  </div>

  <div class="card mt-4 overflow-hidden">
    <div class="flex items-center justify-between border-b border-[color:var(--border-subtle)] px-5 py-3">
      <h2 class="font-[family-name:var(--font-heading)] text-sm font-bold">Daftar cron <span class="font-[family-name:var(--font-body)] text-xs font-normal text-[color:var(--text-faint)]">run terakhir + status asli</span></h2>
      <span class="chip text-[10px]">{liveOk ? "live dari admin" : `${crons.length} terdaftar`}</span>
    </div>
    <ul class="divide-y divide-[color:var(--border-subtle)]">
      {crons.map((c) => {
        const live = liveMap.get(c.name);
        return (
          <li class="px-5 py-2.5 text-sm transition-colors hover:bg-[color:var(--bg-surface-2)]/60">
            <div class="flex items-center gap-3">
              <span class="h-2 w-2 shrink-0 rounded-full" style={`background:${live ? (live.ok ? "var(--success)" : "var(--danger)") : roleColor[c.role]}`}></span>
              <span class="font-[family-name:var(--font-mono-num)] text-xs font-semibold">{c.name}</span>
              {live && !live.ok && <span class="chip chip-danger !text-[9px]">ERROR</span>}
              {live && live.ok && <span class="chip chip-success !text-[9px]">OK</span>}
              <span class="ml-auto font-[family-name:var(--font-mono-num)] text-xs text-[color:var(--text-muted)]">{c.time}</span>
              <span class="chip text-[10px]">{c.role}</span>
            </div>
            {live && (
              <div class="mt-1 pl-5 text-[11px] text-[color:var(--text-faint)]">
                run terakhir: {String(live.started_at).slice(0, 16).replace("T", " ")}
                {live.error && <span class="mt-0.5 block rounded bg-[color:var(--danger-soft)] px-2 py-1 font-mono text-[10px] text-[color:var(--danger)]">{live.error.slice(0, 220)}</span>}
              </div>
            )}
          </li>
        );
      })}
    </ul>
    <p class="border-t border-[color:var(--border-subtle)] px-5 py-3 text-[11px] text-[color:var(--text-faint)]">Status diambil live dari admin tiap buka halaman. Detail penuh di admin Sari Glass (<code class="rounded bg-[color:var(--bg-surface-2)] px-1">cron_runs</code>).</p>
  </div>
</Base>
