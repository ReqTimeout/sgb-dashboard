---
import { getDb } from "../../lib/db";
import { sharedLinks } from "../../../drizzle/schema";
import { series, sumRange, getRequestTenant } from "../../lib/data";
import type { Tenant } from "../../lib/tenant";
import { eq } from "drizzle-orm";
import { fmtInt, fmtRp } from "../../lib/insights";

const token = Astro.params.token;
if (!token) {
  return new Response(null, { status: 302, headers: { Location: "/" } });
}

const db = getDb();
const rows = await db.select().from(sharedLinks).where(eq(sharedLinks.token, token)).limit(1);
const link = rows[0];
if (!link) {
  Astro.response.status = 404;
}
const expired = link?.expiresAt ? new Date(link.expiresAt).getTime() < Date.now() : false;
if (expired) {
  Astro.response.status = 410;
}
const tenant: Tenant | null = link ? await getRequestTenant(Astro.url.host, "/share", new URLSearchParams(), true, link.tenantId) : null;
if (link && !tenant) {
  Astro.response.status = 404;
}

const status = Astro.response.status;

let mSpend = 0, mChats = 0, gSpend = 0, gConv = 0, orgClicks = 0;
let spendDaily: { date: string; value: number }[] = [];
if (tenant) {
  mSpend = sumRange(await series(tenant.id, "meta_ads", "spend", 30), 30, 0);
  mChats = Math.round(sumRange(await series(tenant.id, "meta_ads", "leads", 30), 30, 0));
  gSpend = sumRange(await series(tenant.id, "google_ads", "spend", 30), 30, 0);
  gConv = Math.round(sumRange(await series(tenant.id, "google_ads", "conversions", 30), 30, 0));
  orgClicks = Math.round(sumRange(await series(tenant.id, "seo", "clicks", 30), 30, 0));
  spendDaily = await series(tenant.id, "meta_ads", "spend", 14);
}
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Laporan Publik — {tenant?.name ?? "Tidak ditemukan"}</title>
    <style>
      body { margin: 0; font-family: system-ui, -apple-system, sans-serif; background: #f8fafc; color: #0f172a; }
      .wrap { max-width: 920px; margin: 0 auto; padding: 24px 16px; }
      .hdr { background: #1C1917; color: #fff; padding: 28px 24px; border-radius: 16px; margin-bottom: 16px; }
      .strip { background: repeating-linear-gradient(45deg, #FACC15 0 6px, transparent 6px 12px); height: 4px; border-radius: 2px; margin-bottom: 14px; }
      .badge { display: inline-flex; gap: 6px; align-items: center; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,0.1); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #FACC15; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
      .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; box-shadow: 0 1px 2px rgba(15,23,42,0.04); }
      .lbl { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #94a3b8; }
      .num { font-family: ui-monospace, SFMono-Regular, monospace; font-size: 28px; font-weight: 800; margin-top: 4px; letter-spacing: -0.02em; }
      .sub { font-size: 12px; color: #64748b; margin-top: 2px; }
      .row { display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-top: 1px solid #f1f5f9; font-size: 14px; }
      .row:first-of-type { border-top: 0; }
      .row span:first-child { color: #64748b; }
      .ftr { margin-top: 24px; padding-top: 16px; border-top: 1px solid #e2e8f0; font-size: 11px; color: #94a3b8; text-align: center; }
      .empty { padding: 60px 20px; text-align: center; }
      .empty h1 { font-size: 48px; margin: 0 0 8px; color: #DC2626; }
      .empty p { color: #64748b; margin: 0; }
    </style>
  </head>
  <body>
    <div class="wrap">
      {status === 404 && (
        <div class="empty">
          <h1>404</h1>
          <p>Link tidak ditemukan atau tenant sudah dihapus.</p>
        </div>
      )}
      {status === 410 && (
        <div class="empty">
          <h1>410</h1>
          <p>Link sudah kadaluarsa.</p>
        </div>
      )}
      {link && tenant && (status ?? 0) < 400 && (
        <>
          <div class="hdr">
            <div class="strip"></div>
            <div class="badge">{link.label ?? "Laporan Publik"}</div>
            <h1 style="font-size: 28px; font-weight: 800; margin: 14px 0 4px; letter-spacing: -0.02em;">{tenant.name}</h1>
            <p style="margin: 0; opacity: 0.7; font-size: 14px;">Ringkasan otomatis · 30 hari terakhir</p>
          </div>

          <div class="grid">
            <div class="card"><div class="lbl">Klik Google</div><div class="num">{fmtInt(sumRange(await series(tenant.id, "seo", "clicks", 30), 30, 0))}</div><div class="sub">dari Search organik</div></div>
            <div class="card"><div class="lbl">Belanja iklan</div><div class="num">{fmtRp(mSpend + gSpend)}</div><div class="sub">Meta + Google</div></div>
            <div class="card"><div class="lbl">Prospek</div><div class="num">{fmtInt(mChats + gConv)}</div><div class="sub">chat + konversi</div></div>
            <div class="card"><div class="lbl">Nilai SEO</div><div class="num">Rp{Math.round((orgClicks * 1500) / 1000)}rb</div><div class="sub">estimasi</div></div>
          </div>

          <div class="card" style="margin-top: 12px;">
            <div class="lbl">Belanja harian</div>
            {(() => {
              const w = 560, h = 180, pad = 28;
              const data = spendDaily.slice(-14);
              const max = Math.max(1, ...data.map((p) => Number(p.value ?? 0)));
              const bw = (w - pad * 2) / Math.max(data.length, 1);
              return (
                <svg viewBox={`0 0 ${w} ${h}`} style="width:100%;height:auto;display:block">
                  {data.map((p: { date: string; value: number }, i: number) => {
                    const v = Number(p.value ?? 0);
                    const bh = ((h - pad * 1.5) * v) / max;
                    const x = pad + i * bw + bw * 0.15;
                    return <rect x={x} y={h - pad - bh} width={bw * 0.7} height={bh} fill="#0081fb" rx="3" />;
                  })}
                  <line x1={pad} y1={h - pad} x2={w - pad} y2={h - pad} stroke="#cbd5e1" stroke-width="1" />
                </svg>
              );
            })()}
          </div>

          <div class="card" style="margin-top: 12px;">
            <div class="lbl">Ringkasan per channel</div>
            <div class="row"><span>Meta Ads · chat</span> <strong>{fmtInt(mChats)}</strong></div>
            <div class="row"><span>Meta Ads · CPA per chat</span> <strong>{mChats ? fmtRp(Math.round(mSpend / mChats)) : "—"}</strong></div>
            <div class="row"><span>Google Ads · konversi</span> <strong>{fmtInt(gConv)}</strong></div>
            <div class="row"><span>Organik · klik</span> <strong>{fmtInt(orgClicks)}</strong></div>
          </div>

          <div class="card" style="margin-top: 12px; text-align: center; padding: 16px; background: rgb(16 185 129 / 0.08); border-color: rgb(16 185 129 / 0.4);">
            <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #047857;">Pantau otomatis · Beriklan Agency</div>
            <div style="font-size: 13px; color: #475569; margin-top: 4px;">Halaman ini di-refresh setiap hari pukul 06:45 WIB.{link.expiresAt ? ` Berlaku sampai ${new Date(link.expiresAt).toLocaleDateString("id-ID")}.` : ""}</div>
          </div>

          <div class="ftr">Laporan publik dihasilkan otomatis oleh sgb.beriklan.co.id · {new Date().toLocaleString("id-ID")}</div>
        </>
      )}
    </div>
  </body>
</html>
