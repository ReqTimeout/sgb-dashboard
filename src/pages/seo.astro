---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import LineChartLC from "../components/LineChartLC.svelte";
import BarChartLC from "../components/BarChartLC.svelte";
import Icon from "../components/Icon.astro";
import InfoHint from "../components/InfoHint.astro";
import EmptyState from "../components/EmptyState.astro";
import { getRequestTenant, latestRanks, series, sumRange } from "../lib/data";
import { fmtInt, fmtNum, fmtPct, fmtRp } from "../lib/insights";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

const clicks = await series(tenant.id, "seo", "clicks", 90);
const impr = await series(tenant.id, "seo", "impressions", 90);
const ctr = await series(tenant.id, "seo", "ctr", 90);
const pos = await series(tenant.id, "seo", "position", 90);

const totClicks = clicks.reduce((a, p) => a + p.value, 0);
const totImpr = impr.reduce((a, p) => a + p.value, 0);
const avgCtr = ctr.length ? ctr.reduce((a, p) => a + p.value, 0) / ctr.length : null;
const avgPos = pos.length ? pos.reduce((a, p) => a + p.value, 0) / pos.length : null;

// Trend 30 vs 60 hari lalu
const sum30 = sumRange(clicks, 30, 0);
const prev30 = sumRange(clicks, 60, 31);
const trendClicks = prev30 > 0 ? ((sum30 - prev30) / prev30) * 100 : 0;
const sumImp30 = sumRange(impr, 30, 0);
const prevImp30 = sumRange(impr, 60, 31);
const trendImpr = prevImp30 > 0 ? ((sumImp30 - prevImp30) / prevImp30) * 100 : 0;

// Opportunity: query di posisi 4-10 + impressions > 100 → kandidat klik banyak
const ranks = await latestRanks(tenant.id, 100);
const queries = ranks.filter((r) => !r.keyword.startsWith("page:"));
const top10 = queries.filter((r) => r.position != null && r.position > 3 && r.position <= 10 && (r.impressions ?? 0) > 30);
top10.sort((a, b) => (b.impressions ?? 0) - (a.impressions ?? 0));
const opportunities = top10.slice(0, 8);

const pages = ranks.filter((r) => r.keyword.startsWith("page:")).slice(0, 10);
const snapDate = ranks[0]?.date ?? null;

// D5.1: status GBP dari cron terakhir (via admin audit)
let gbp: { connected: boolean; name?: string; total?: number; avg?: number; unanswered?: number; newest?: { stars?: string; by?: string; comment?: string }[] } = { connected: false };
try {
  const adminUrl = (process.env.ADMIN_URL ?? "https://admin.sariglassbangunan.com").replace(/\/$/, "");
  const adminToken = process.env.ADMIN_CRON_TOKEN ?? "";
  const r = await fetch(`${adminUrl}/api/audit/crons?token=${encodeURIComponent(adminToken)}`);
  if (r.ok) {
    const j = await r.json();
    const g = (j.crons ?? []).find((c: { name: string }) => c.name === "gbp-reviews");
    const s = g?.summary;
    if (s?.connected) {
      gbp = { connected: true, name: s.name, total: s.total, avg: s.avg, unanswered: s.unanswered, newest: s.newest ?? [] };
    }
  }
} catch { /* abaikan — tampil sebagai menunggu OAuth */ }

// Hero narrative
const heroNarative = totClicks > 0
  ? `${fmtInt(totClicks)} klik masuk dari Google 90 hari — ${trendClicks > 0 ? "naik" : trendClicks < 0 ? "turun" : "stabil"} ${Math.abs(trendClicks).toFixed(0)}% vs 30 hari sebelumnya.${avgPos && avgPos <= 10 ? " Halaman 1 Google — bisnis Anda ditemukan tanpa bayar iklan." : " Belum halaman 1 — ada peluang naik."}`
  : "Mesin sudah jalan. Data GSC pertama biasanya masuk H+2 setelah push 05:00 WIB.";


---
<Base title="Performa SEO" tenantName={tenant.name}>
  <!-- HERO INSIGHT -->
  <div class="relative overflow-hidden rounded-2xl px-6 py-6 grain" style="background: linear-gradient(135deg, #1C1917 0%, #292524 100%); color: #fff;">
    <div class="hazard-stripe absolute inset-x-0 top-0"></div>
    <div class="relative z-10 grid gap-5 sm:grid-cols-[1fr_auto] sm:items-end">
      <div>
        <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#FACC15]">Performa SEO — {tenant.name}</div>
        <div class="mt-2 text-display text-2xl sm:text-3xl">{heroNarative}</div>
        {snapDate && <div class="mt-2 text-[11px] text-white/55">Data per {snapDate} (GSC delay ~2 hari)</div>}
      </div>
      <div class="grid gap-2 sm:gap-3">
        <div class="rounded-xl border border-white/15 px-4 py-3">
          <div class="text-[10px] text-white/55 uppercase tracking-[0.12em]">Nilai klik organik 90h</div>
          <div class="font-[family-name:var(--font-display)] text-2xl font-extrabold text-[#34d399]">{fmtRp(totClicks * 1500)}</div>
          <div class="text-[10px] text-white/55">estimasi budget Meta kalau beli klik sebanyak ini</div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <StatCard label="Klik 90 hari" value={fmtInt(totClicks)} delta={trendClicks} spark={clicks.slice(-14).map((p) => p.value)} source={"GSC searchAnalytics · push 05:00 WIB · update tiap hari dari Google Search Console"} />
    <StatCard label="Tayang 90 hari" value={fmtNum(totImpr)} delta={trendImpr} hint="kali tampil di pencarian" spark={impr.slice(-14).map((p) => p.value)} source={"GSC searchAnalytics · 05:00 WIB · impressions = berapa kali muncul di hasil Google"} />
    <StatCard label="CTR rata-rata" value={fmtPct(avgCtr)} hint="benchmark Indonesia e-commerce 2-4%" ok={(avgCtr ?? 0) >= 0.02} warn={(avgCtr ?? 1) < 0.01} source={"Klik ÷ Tayang. Naik = judul/meta lebih menarik di mata user. Indonesia ritel 2-4% dianggap sehat."} />
    <StatCard label="Posisi rata-rata" value={avgPos ? avgPos.toFixed(1).replace(".", ",") : "—"} hint="≤10 = halaman 1 Google" ok={avgPos != null && avgPos <= 10} warn={avgPos != null && avgPos > 20} source={"Rata-rata posisi semua keyword yang dapat klik. ≤10 berarti sudah di halaman 1."} />
  </div>

  <div class="card mt-4 p-5">
    <div class="flex items-center justify-between">
      <h2 class="font-[family-name:var(--font-heading)] text-sm font-bold">Tren harian <span class="font-[family-name:var(--font-body)] text-xs font-normal text-[color:var(--text-faint)]">klik merah, tayang abu-abu</span></h2>
      <span class="chip text-[10px]">{clicks.length} hari data</span>
    </div>
    <div class="mt-3">
      {clicks.length > 0 ? (
        <div class="grid gap-4 lg:grid-cols-2">
          <div>
            <div class="mb-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Klik /hari</div>
            <LineChartLC data={clicks} height={220}  client:visible />
          </div>
          <div>
            <div class="mb-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Tayang /hari</div>
            <BarChartLC data={impr.map((p) => ({ label: p.date.slice(5), value: Math.round(p.value) }))} height={220}  client:visible />
          </div>
        </div>
      ) : (
        <p class="py-8 text-center text-sm text-[color:var(--text-faint)]">Belum ada data — push GSC pertama jalan 05:00 WIB.</p>
      )}
    </div>
  </div>

  <!-- GOOGLE BUSINESS PROFILE (D5.1): review + status koneksi -->
  <div class="card mt-4 p-5">
    <div class="flex items-center gap-3">
      <div class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[color:var(--success-soft)] text-[color:var(--success)]">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.5-7-11a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 6.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
      </div>
      <div class="flex-1">
        <div class="font-[family-name:var(--font-heading)] text-sm font-bold">Google Business Profile <span class="font-[family-name:var(--font-body)] text-xs font-normal text-[color:var(--text-faint)]">ulasan & panggilan lokal</span></div>
        {gbp.connected ? (
          <p class="mt-0.5 text-xs text-[color:var(--text-muted)]">
            <strong class="text-[color:var(--text-primary)]">{gbp.name ?? "Profil terhubung"}</strong> ·
            rating {gbp.avg ?? "—"} · {gbp.total ?? 0} ulasan
            {gbp.unanswered ? <span class="chip chip-warning ml-2 text-[10px]">{gbp.unanswered} belum dibalas</span> : <span class="chip chip-success ml-2 text-[10px]">semua dibalas</span>}
          </p>
        ) : (
          <p class="mt-0.5 text-xs text-[color:var(--text-muted)]">
            Belum terhubung — butuh otorisasi Google sekali (OAuth). Setelah itu ulasan terbaru, rating, dan panggilan lokal tampil di sini otomatis tiap minggu.
          </p>
        )}
      </div>
      <span class:list={["chip shrink-0 text-[10px]", gbp.connected ? "chip-success" : "chip"]}>{gbp.connected ? "terhubung" : "menunggu OAuth"}</span>
    </div>
    {gbp.connected && gbp.newest && gbp.newest.length > 0 && (
      <ul class="mt-3 space-y-2">
        {gbp.newest.slice(0, 3).map((r: { stars?: string; by?: string; comment?: string }) => (
          <li class="rounded-lg bg-[color:var(--bg-surface-2)]/60 px-3 py-2 text-sm">
            <span class="font-bold">{"★".repeat(Math.min(5, parseInt(String(r.stars ?? "5").replace(/\D/g, "") || "5")))}</span>
            <span class="text-[color:var(--text-muted)]"> {r.by ?? "Anonim"}</span>
            <p class="mt-0.5 text-[color:var(--text-secondary)]">{r.comment ?? ""}</p>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- OPPORTUNITY: posisi 4-10 + impressions tinggi -->
  <div class="card mt-4 overflow-hidden">
    <div class="flex items-center justify-between border-b border-[color:var(--border-subtle)] px-5 py-3">
      <h2 class="flex items-center gap-2 font-[family-name:var(--font-heading)] text-sm font-bold">
        <Icon name="target" size="sm" strokeWidth={1.75} />
        Peluang cepat
        <span class="font-[family-name:var(--font-body)] text-xs font-normal text-[color:var(--text-faint)]">keyword halaman 2-3 yang banyak dicari</span>
      </h2>
      <span class="chip text-[10px]">{opportunities.length} kandidat</span>
    </div>
    {opportunities.length === 0 ? (
      <EmptyState
        title="Belum ada peluang"
        message="Keyword posisi 4-10 dengan tayang tinggi belum terdeteksi."
        mascot="search"
        when="Biasanya muncul 2-3 bulan setelah artikel halaman-1 mulai stabil."
        action="Biarin mesin jalan — keyword yang ada sedang naik perlahan."
      />
    ) : (
      <table class="w-full text-sm">
        <thead class="bg-[color:var(--bg-surface-2)]/60 text-left text-[10px] uppercase tracking-[0.12em] text-[color:var(--text-faint)]">
          <tr><th class="px-5 py-2.5">Keyword</th><th class="px-2 py-2.5 text-right">Pos</th><th class="px-2 py-2.5 text-right">Tayang</th><th class="px-2 py-2.5 text-right">Klik</th><th class="px-5 py-2.5">Aksi</th></tr>
        </thead>
        <tbody>
          {opportunities.map((o) => (
            <tr class="border-t border-[color:var(--border-subtle)] transition-colors hover:bg-[color:var(--bg-surface-2)]/60">
              <td class="px-5 py-2.5 font-medium">{o.keyword}</td>
              <td class="px-2 py-2.5 text-right"><span class="chip chip-warning text-[10px]">Hal. {Math.ceil((o.position ?? 0) / 10)} · {o.position?.toFixed(0)}</span></td>
              <td class="px-2 py-2.5 text-right font-[family-name:var(--font-mono-num)]">{fmtInt(o.impressions)}</td>
              <td class="px-2 py-2.5 text-right font-[family-name:var(--font-mono-num)] font-semibold">{fmtInt(o.clicks)}</td>
              <td class="px-5 py-2.5 text-[11px] text-[color:var(--text-muted)]">Tambah FAQ + internal link</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div class="card overflow-hidden">
      <div class="border-b border-[color:var(--border-subtle)] px-5 py-3">
        <h2 class="font-[family-name:var(--font-heading)] text-sm font-bold">Pencarian teratas <span class="font-[family-name:var(--font-body)] text-xs font-normal text-[color:var(--text-faint)]">yang bawa klik</span></h2>
      </div>
      <table class="w-full text-sm">
        <thead class="text-left text-[10px] uppercase tracking-[0.12em] text-[color:var(--text-faint)]">
          <tr><th class="px-5 py-2">Query</th><th class="px-2 py-2 text-right">Klik</th><th class="px-2 py-2 text-right">Posisi</th></tr>
        </thead>
        <tbody>
          {queries.slice(0, 10).length === 0 && <tr><td colspan="3" class="px-4 py-6 text-center text-[color:var(--text-faint)]">—</td></tr>}
          {queries.slice(0, 10).map((q) => (
            <tr class="border-t border-[color:var(--border-subtle)] transition-colors hover:bg-[color:var(--bg-surface-2)]/60">
              <td class="px-5 py-2">{q.keyword}</td>
              <td class="px-2 py-2 text-right font-[family-name:var(--font-mono-num)] font-semibold">{fmtInt(q.clicks)}</td>
              <td class="px-2 py-2 text-right font-[family-name:var(--font-mono-num)]">{q.position?.toFixed(1) ?? "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="card overflow-hidden">
      <div class="border-b border-[color:var(--border-subtle)] px-5 py-3">
        <h2 class="font-[family-name:var(--font-heading)] text-sm font-bold">Halaman teratas <span class="font-[family-name:var(--font-body)] text-xs font-normal text-[color:var(--text-faint)]">paling banyak diklik</span></h2>
      </div>
      <table class="w-full text-sm">
        <thead class="text-left text-[10px] uppercase tracking-[0.12em] text-[color:var(--text-faint)]">
          <tr><th class="px-5 py-2">Halaman</th><th class="px-2 py-2 text-right">Klik</th><th class="px-2 py-2 text-right">Pos</th></tr>
        </thead>
        <tbody>
          {pages.length === 0 && <tr><td colspan="3" class="px-4 py-6 text-center text-[color:var(--text-faint)]">—</td></tr>}
          {pages.map((p) => (
            <tr class="border-t border-[color:var(--border-subtle)] transition-colors hover:bg-[color:var(--bg-surface-2)]/60">
              <td class="px-5 py-2 truncate text-xs">{((p.keyword ?? "").replace("page:", "/").slice(0, 60)) || "/"}</td>
              <td class="px-2 py-2 text-right font-[family-name:var(--font-mono-num)] font-semibold">{fmtInt(p.clicks)}</td>
              <td class="px-2 py-2 text-right font-[family-name:var(--font-mono-num)]">{p.position?.toFixed(1) ?? "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Base>
