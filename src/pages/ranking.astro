---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import { getRequestTenant, latestRanks, rankHistory } from "../lib/data";
import { fmtInt, insightPosition } from "../lib/insights";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

const ranks = (await latestRanks(tenant.id, 50)).filter((r) => !r.keyword.startsWith("page:")).slice(0, 20);
const movers: { keyword: string; now: number | null; prev: number | null; move: number | null; clicks: number | null }[] = [];
for (const r of ranks) {
  const hist = await rankHistory(tenant.id, r.keyword, 10);
  const prev = hist.length > 1 ? hist[0].value : null;
  movers.push({
    keyword: r.keyword,
    now: r.position,
    prev,
    move: r.position != null && prev != null ? prev - r.position : null,
    clicks: r.clicks,
  });
}
movers.sort((a, b) => (b.move ?? -999) - (a.move ?? -999));
const avg = ranks.length ? ranks.reduce((a, r) => a + (r.position ?? 0), 0) / ranks.filter((r) => r.position != null).length : null;
const top3 = movers.filter((m) => m.now != null && m.now <= 3).length;
const top10 = movers.filter((m) => m.now != null && m.now <= 10).length;
const up7 = movers.filter((m) => (m.move ?? 0) > 0).length;

function badge(pos: number | null): string {
  if (pos == null) return `<span class="chip">—</span>`;
  if (pos <= 3) return `<span class="chip chip-warning">TOP ${pos}</span>`;
  if (pos <= 10) return `<span class="chip chip-success">Hal. 1 · ${pos}</span>`;
  return `<span class="chip">Hal. 2+ · ${pos}</span>`;
}
---
<Base title="Ranking Tracker" tenantName={tenant.name}>
  <div class="relative overflow-hidden rounded-2xl px-6 py-6 grain" style="background: linear-gradient(135deg, #1C1917 0%, #292524 100%); color: #fff;">
    <div class="hazard-stripe absolute inset-x-0 top-0"></div>
    <div class="relative z-10">
      <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#FACC15]">Ranking Tracker — {tenant.name}</div>
      <div class="mt-2 text-display text-2xl sm:text-3xl">
        {insightPosition(avg)}
      </div>
      <p class="mt-2 max-w-xl text-sm text-white/80">
        {up7 > 0 ? `${up7} keyword naik minggu ini, ${movers.filter((m) => (m.move ?? 0) < 0).length} turun.` : "Belum ada pergerakan signifikan minggu ini."}
        {" "}{top3 > 0 ? `${top3} di TOP 3 (gold tier).` : ""}
      </p>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <StatCard label="Rata-rata posisi" value={avg ? avg.toFixed(1).replace(".", ",") : "—"} hint="≤10 = halaman 1 Google" source={"Rata-rata rank_snapshots.keyword agregat. Push tiap pagi 05:10 WIB."} />
    <StatCard label="TOP 3" value={fmtInt(top3)} hint="gold tier" source={"Keyword dengan posisi ≤3 di Google. Driver utama klik organik."} />
    <StatCard label="TOP 10" value={fmtInt(top10)} hint="page 1" source={"Keyword di posisi 4-10 (= halaman 1 Google). Sweet spot untuk didorong naik ke TOP 3."} />
    <StatCard label="Naik 7 hari" value={fmtInt(up7)} delta={up7 - movers.filter((m) => (m.move ?? 0) < 0).length} hint={up7 > movers.filter((m) => (m.move ?? 0) < 0).length ? "netral ke atas" : "netral ke bawah"} source={"Δ posisi ranking vs 7 hari lalu. Naik = makin page-one; turun = turun halaman."} />
  </div>

  <div class="mt-4 overflow-x-auto rounded-2xl border border-[color:var(--border-default)] bg-[color:var(--bg-surface)]">
    <table class="w-full min-w-[640px] text-sm">
      <thead>
        <tr class="text-left text-[10px] uppercase tracking-[0.12em] text-[color:var(--text-faint)]">
          <th class="px-5 py-3">Keyword</th>
          <th class="px-2 py-3 text-right">Pos</th>
          <th class="px-2 py-3 text-right">Δ 7 hari</th>
          <th class="px-2 py-3 text-right">Klik</th>
          <th class="px-5 py-3">Status</th>
        </tr>
      </thead>
      <tbody>
        {movers.length === 0 && (
          <tr><td colspan="5" class="px-4 py-10 text-center text-[color:var(--text-faint)]">Belum ada data — push GSC pertama jalan 05:00 WIB.</td></tr>
        )}
        {movers.map((m) => (
          <tr class="border-t border-[color:var(--border-subtle)] transition-colors hover:bg-[color:var(--bg-surface-2)]/60">
            <td class="px-5 py-3 font-medium">{m.keyword}</td>
            <td class="px-2 py-3 text-right">
              <span class:list={["font-[family-name:var(--font-mono-num)] text-lg font-extrabold", m.now != null && m.now <= 3 ? "text-[color:var(--brand)]" : ""]}>{m.now ?? "—"}</span>
            </td>
            <td class="px-2 py-3 text-right font-[family-name:var(--font-mono-num)] font-semibold">
              {m.move == null ? <span class="text-[color:var(--text-faint)]">—</span>
                : m.move > 0 ? <span class="chip chip-success">▲ {m.move}</span>
                : m.move < 0 ? <span class="chip chip-danger">▼ {Math.abs(m.move)}</span>
                : <span class="text-[color:var(--text-faint)]">▬</span>}
            </td>
            <td class="px-2 py-3 text-right font-[family-name:var(--font-mono-num)]">{fmtInt(m.clicks)}</td>
            <td class="px-5 py-3"><Fragment set:html={badge(m.now)} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-3 flex items-center gap-1.5 text-xs text-[color:var(--text-muted)]">
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2"/></svg>
    Cara baca: ▲ hijau = naik peringkat (bagus). Coba Google sendiri keyword TOP 3 untuk buktikan.
  </p>
</Base>
