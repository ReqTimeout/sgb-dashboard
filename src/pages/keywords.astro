---
import Base from "../layouts/Base.astro";
import EmptyState from "../components/EmptyState.astro";
import Icon from "../components/Icon.astro";
import InfoHint from "../components/InfoHint.astro";
import { getRequestTenant } from "../lib/data";
import { and, desc, eq, inArray, like, or, sql } from "drizzle-orm";
import { getDb } from "../lib/db";
import { keywordInventory } from "../../drizzle/schema";
import { fmtInt, formatTanggal } from "../lib/insights";
import { CLUSTERS } from "../lib/keywords/enrich";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

const PAGE_SIZE = 50;
// Status tampil (Bos) → status DB. Rantai: Pending → Artikel dibuat → On progress publish → Publish.
const STATUS_GROUPS: Record<string, string[]> = {
  pending: ["antre"],
  "artikel-dibuat": ["draft"],
  "on-progress": ["terbit"],
  publish: ["ter-commit", "diajukan"],
};
const ALL_STATUSES = Object.keys(STATUS_GROUPS);
const CLUSTER_LABELS: Record<string, string> = Object.fromEntries(CLUSTERS.map((c) => [c.id, c.label]));

// Query params
const statusParam = Astro.url.searchParams.get("status") ?? "";
const clusterParam = Astro.url.searchParams.get("cluster") ?? "";
const cityParam = Astro.url.searchParams.get("city") ?? "";
const sortParam = Astro.url.searchParams.get("sort") ?? "lokal"; // default: lokal dulu (Majenang → Cilacap Raya)
const pageParam = Math.max(1, parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);
const q = (Astro.url.searchParams.get("q") ?? "").trim();

// Build Drizzle WHERE conditions
const where = [eq(keywordInventory.tenantId, tenant.id)];
if (statusParam && (ALL_STATUSES as string[]).includes(statusParam)) {
  where.push(inArray(keywordInventory.status, STATUS_GROUPS[statusParam]));
}
if (clusterParam && CLUSTERS.find((c) => c.id === clusterParam)) {
  where.push(eq(keywordInventory.cluster, clusterParam) as any);
}
if (cityParam) {
  where.push(eq(keywordInventory.city, cityParam) as any);
}

const db = getDb();

// Hitung total untuk pagination & counts (di-cache pada tiap render)
const countResult = await db
  .select({
    total: sql<number>`COUNT(*)`,
  })
  .from(keywordInventory)
  .where(and(...where));
const total = Number(countResult[0]?.total ?? 0);

// Counts per status → agregat ke 4 grup tampil
const statusCountResult = await db
  .select({
    status: keywordInventory.status,
    n: sql<number>`COUNT(*)`,
  })
  .from(keywordInventory)
  .where(eq(keywordInventory.tenantId, tenant.id))
  .groupBy(keywordInventory.status);
const dbCounts: Record<string, number> = Object.fromEntries(
  statusCountResult.map((r) => [r.status, Number(r.n ?? 0)]),
);
const counts: Record<string, number> = {};
for (const g of ALL_STATUSES) counts[g] = STATUS_GROUPS[g].reduce((a, s) => a + (dbCounts[s] ?? 0), 0);

// Sort whitelist. Default "lokal" = local-first (Majenang, lalu Cilacap Raya),
// baru opportunity DESC — strategi winning lokal dulu.
type SortKey = "lokal" | "opportunity" | "priority" | "updated" | "keyword";
const LOCAL_ORDER = sql`CASE WHEN ${keywordInventory.city} = 'Majenang' THEN 0 WHEN ${keywordInventory.city} LIKE '%Cilacap%' THEN 1 ELSE 2 END`;
const SORT_MAP = {
  lokal: LOCAL_ORDER,
  opportunity: desc(keywordInventory.opportunity),
  priority: desc(keywordInventory.priority),
  updated: desc(keywordInventory.updatedAt),
  keyword: desc(keywordInventory.keyword),
} as const;
const sortKey = (Object.keys(SORT_MAP).includes(sortParam) ? sortParam : "lokal") as SortKey;
const orderByExpr = sortKey === "lokal"
  ? [LOCAL_ORDER, desc(keywordInventory.opportunity)]
  : [SORT_MAP[sortKey]];

// Next up: 3 keyword Pending lokal teratas (opportunity DESC) —
// inilah yang NEXT dibuatkan artikel. Bos + tim lihat strip ini tiap pagi.
const nextUp = await db
  .select({
    keyword: keywordInventory.keyword,
    city: keywordInventory.city,
    opportunity: keywordInventory.opportunity,
    suggestion: keywordInventory.suggestion,
  })
  .from(keywordInventory)
  .where(
    and(
      eq(keywordInventory.tenantId, tenant.id),
      eq(keywordInventory.status, "antre"),
      or(eq(keywordInventory.city, "Majenang"), like(keywordInventory.city, "%Cilacap%")),
    ),
  )
  .orderBy(desc(keywordInventory.opportunity))
  .limit(3);

// Paginated query + filter q di memory (1 halaman max 50 baris — OK)
const offset = (pageParam - 1) * PAGE_SIZE;
const rows = await db
  .select()
  .from(keywordInventory)
  .where(and(...where))
  .orderBy(...orderByExpr)
  .limit(PAGE_SIZE)
  .offset(offset);
const list = q
  ? rows.filter(
      (r) =>
        r.keyword.toLowerCase().includes(q.toLowerCase()) ||
        (r.normalizedKeyword ?? "").includes(q.toLowerCase()) ||
        (r.city ?? "").toLowerCase().includes(q.toLowerCase()),
    )
  : rows;

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const isSuperadmin = user.role === "superadmin";

// Live index-stage dari admin per articleSlug (dibuat → menunggu-publish →
// menunggu-terindex → terindex). Pola sama seperti health.astro (fetch server-side).
let indexStage: Record<string, { stage: string }> = {};
try {
  const adminUrl = (process.env.ADMIN_URL ?? "https://admin.sariglassbangunan.com").replace(/\/$/, "");
  const adminToken = process.env.ADMIN_CRON_TOKEN ?? "";
  const slugs = [...new Set(list.map((r) => r.articleSlug).filter(Boolean))] as string[];
  if (adminToken && slugs.length > 0) {
    const r = await fetch(`${adminUrl}/api/seo/keyword-status?token=${encodeURIComponent(adminToken)}&slugs=${encodeURIComponent(slugs.join(","))}`, { signal: AbortSignal.timeout(15000) });
    if (r.ok) {
      const j = await r.json();
      indexStage = j.states ?? {};
    }
  }
} catch { /* admin down — badge index disembunyikan */ }
const INDEX_BADGE: Record<string, { label: string; cls: string }> = {
  "menunggu-publish": { label: "Menunggu publish", cls: "chip chip-warning" },
  "menunggu-terindex": { label: "Menunggu terindex", cls: "chip chip-info" },
  "terindex": { label: "Terindex", cls: "chip chip-success" },
};

// ETA sederhana: kecepatan = rata-rata publish per minggu (from articlesView).
// Kita pakai proxy: terbit total ÷ jumlah minggu aktif. Untuk sekarang, hardcode ETA dari total antre.
const lastEnrich = rows.find((r) => r.opportunityUpdatedAt)?.opportunityUpdatedAt ?? null;

// Build link helper — preserve other params
const linkBase = (overrides: Record<string, string | null>): string => {
  const p = new URLSearchParams();
  if (!overrides.hasOwnProperty("status") && statusParam) p.set("status", statusParam);
  if (!overrides.hasOwnProperty("cluster") && clusterParam) p.set("cluster", clusterParam);
  if (!overrides.hasOwnProperty("city") && cityParam) p.set("city", cityParam);
  if (!overrides.hasOwnProperty("sort") && sortParam) p.set("sort", sortParam);
  if (!overrides.hasOwnProperty("q") && q) p.set("q", q);
  for (const [k, v] of Object.entries(overrides)) {
    if (v === null) continue;
    p.set(k, v);
  }
  const qs = p.toString();
  return `/keywords${qs ? "?" + qs : ""}`;
};

const chipCls: Record<string, string> = {
  pending: "chip",
  "artikel-dibuat": "chip chip-warning",
  "on-progress": "chip chip-info",
  publish: "chip chip-success",
};
// DB status → grup tampil (untuk baris tabel)
function groupOf(dbStatus: string): string {
  for (const g of ALL_STATUSES) if (STATUS_GROUPS[g].includes(dbStatus)) return g;
  return "pending";
}
const STATUS_LABEL: Record<string, string> = {
  pending: "Pending",
  "artikel-dibuat": "Artikel dibuat",
  "on-progress": "On progress publish",
  publish: "Publish",
};
---
<Base title="Keyword Inventory" tenantName={tenant.name}>
  <p class="mt-1 text-sm text-[color:var(--text-muted)]">
    {tenant.name} · {fmtInt(total)} keyword terlacak — lokal (Majenang/Cilacap) dulu di atas.
    {lastEnrich && (
      <span class="ml-2">Enrichment terakhir: {formatTanggal(lastEnrich.toString(), true)}.</span>
    )}
  </p>

  <!-- FILTER BAR -->
  <div class="mt-4 space-y-2">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Status</span>
      <a href={linkBase({ status: null, page: "1" })} class:list={["rounded-full px-3 py-1 text-xs transition-colors", !statusParam ? "bg-[color:var(--brand)] text-white font-bold" : "bg-[color:var(--bg-surface-2)] hover:bg-[color:var(--bg-surface)]"]}>Semua ({fmtInt(total)})</a>
      {ALL_STATUSES.filter((s) => counts[s] > 0).map((s) => (
        <a href={linkBase({ status: s, page: "1" })} class:list={["rounded-full px-3 py-1 text-xs transition-colors", statusParam === s ? "bg-[color:var(--brand)] text-white font-bold" : "bg-[color:var(--bg-surface-2)] hover:bg-[color:var(--bg-surface)]"]}>
          {STATUS_LABEL[s] ?? s} ({fmtInt(counts[s])})
        </a>
      ))}
      <span class="ml-auto">
        <InfoHint source={`Sort default: Lokal dulu (Majenang → Cilacap Raya → lainnya), lalu opportunity DESC. Strategi winning lokal dulu.`} variant="info" />
      </span>
    </div>

    {(clusterParam || cityParam || q) && (
      <div class="flex flex-wrap items-center gap-2 rounded-lg border border-[color:var(--border-subtle)] bg-[color:var(--bg-surface-2)]/50 px-3 py-2 text-xs">
        <span class="font-semibold text-[color:var(--text-secondary)]">Filter aktif:</span>
        {statusParam && <span class="chip chip-brand">status: {STATUS_LABEL[statusParam] ?? statusParam}</span>}
        {clusterParam && <span class="chip chip-brand">klaster: {CLUSTER_LABELS[clusterParam] ?? clusterParam}</span>}
        {cityParam && <span class="chip chip-brand">{cityParam}</span>}
        {q && <span class="chip chip-brand">q: "{q}"</span>}
        <a href="/keywords" class="ml-auto text-[color:var(--info)] hover:underline">Hapus semua</a>
      </div>
    )}

    <form method="get" action="/keywords" class="flex flex-wrap items-center gap-2">
      {statusParam && <input type="hidden" name="status" value={statusParam} />}
      {clusterParam && <input type="hidden" name="cluster" value={clusterParam} />}
      {cityParam && <input type="hidden" name="city" value={cityParam} />}
      {sortParam && <input type="hidden" name="sort" value={sortParam} />}
      <input type="search" name="q" value={q} placeholder="Cari keyword / kota…" class="rounded-full border border-[color:var(--border-subtle)] bg-[color:var(--bg-surface)] px-3 py-1 text-sm flex-1 min-w-[180px]" />
      <select name="sort" class="rounded-full border border-[color:var(--border-subtle)] bg-[color:var(--bg-surface)] px-3 py-1 text-sm">
        <option value="lokal" selected={sortParam === "lokal"}>Sort: Lokal dulu</option>
        <option value="opportunity" selected={sortParam === "opportunity"}>Sort: Peluang</option>
        <option value="priority" selected={sortParam === "priority"}>Sort: Prioritas</option>
        <option value="updated" selected={sortParam === "updated"}>Sort: Terbaru di-update</option>
        <option value="keyword" selected={sortParam === "keyword"}>Sort: A-Z</option>
      </select>
      <button class="btn btn-primary !py-1 text-xs">Terapkan</button>
    </form>

    <div class="flex flex-wrap items-center gap-1.5">
      <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Klaster</span>
      {CLUSTERS.map((c) => (
        <a href={linkBase({ cluster: clusterParam === c.id ? null : c.id, page: "1" })} class:list={["rounded-full px-3 py-1 text-xs transition-colors", clusterParam === c.id ? "bg-[color:var(--brand)] text-white font-bold" : "bg-[color:var(--bg-surface-2)] hover:bg-[color:var(--bg-surface)]"]}>{c.label}</a>
      ))}
    </div>
  </div>

  <!-- NEXT UP — 3 keyword Pending lokal teratas = yang NEXT dibuatkan artikel -->
  {nextUp.length > 0 && (
    <div class="mt-4 rounded-2xl border border-[color:var(--brand)]/30 bg-[color:var(--brand-soft)]/40 p-4">
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--brand)]">Next up — dibuatkan artikel</span>
        <InfoHint source="Top 3 status Pending di Majenang/Cilacap Raya, opportunity tertinggi. Inilah antrian artikel berikutnya." variant="info" />
      </div>
      <ol class="mt-2 space-y-1.5">
        {nextUp.map((n, i) => (
          <li class="flex items-center gap-2 text-sm">
            <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[color:var(--brand)] text-[10px] font-bold text-white">{i + 1}</span>
            <span class="min-w-0 flex-1 truncate font-medium">{n.keyword}</span>
            <span class="shrink-0 text-[11px] text-[color:var(--text-muted)]">{n.city ?? "—"}</span>
            <span class="shrink-0 font-[family-name:var(--font-mono-num)] text-[11px] font-bold">peluang {fmtInt(n.opportunity)}</span>
          </li>
        ))}
      </ol>
    </div>
  )}

  <!-- BULK ACTION FORM -->
  {isSuperadmin && list.length > 0 && (
    <form method="post" action="/api/keywords/bulk" class="mt-4" id="bulkForm">
      <div class="card flex flex-wrap items-center gap-2 px-4 py-2.5 text-sm">
        <label class="inline-flex cursor-pointer items-center gap-2">
          <input type="checkbox" id="selectAll" class="rounded" />
          <span class="text-xs text-[color:var(--text-muted)]">Pilih semua (50 baris di halaman ini)</span>
        </label>
        <span class="text-[color:var(--text-faint)]">|</span>
        <select name="action" class="rounded-full border border-[color:var(--border-subtle)] bg-[color:var(--bg-surface)] px-3 py-1 text-xs">
          <option value="">— Aksi bulk —</option>
          <option value="bump_priority_10">Naikkan prioritas +10</option>
          <option value="drop_priority_10">Turunkan prioritas −10</option>
          <option value="set_cluster_keramik">Set klaster: Keramik</option>
          <option value="set_cluster_atap">Set klaster: Atap</option>
          <option value="set_cluster_tools">Set klaster: Tools</option>
          <option value="delete">Hapus (batch)</option>
        </select>
        <button type="submit" class="btn !py-1 text-xs" onclick="return confirm('Yakin eksekusi untuk keyword yang dipilih?')">Eksekusi</button>
        <span class="ml-auto text-xs text-[color:var(--text-faint)]">{list.length} baris di halaman ini</span>
      </div>

      {list.length === 0 ? (
        <EmptyState
          title={q || statusParam || clusterParam || cityParam ? "Tidak ada hasil" : "Belum ada keyword"}
          message={
            q
              ? "Coba kata kunci lain atau hapus filter."
              : "Snapshot keyword pertama jalan 05:10 WIB — halaman ini terisi otomatis."
          }
          mascot="search"
          when="Snapshot harian 05:10 WIB dari pipeline GSC + keyword-harvester."
          action="Untuk enrichment manual, jalankan /api/cron/migrate-keywords (lihat deployments)."
        />
      ) : (
        <div class="card mt-2 overflow-x-auto !p-0">
          <table class="w-full min-w-[820px] text-sm">
            <thead>
              <tr class="text-left text-[10px] uppercase tracking-[0.12em] text-[color:var(--text-faint)]">
                <th class="w-8 px-3 py-2.5"></th>
                <th class="px-3 py-2.5">Keyword</th>
                <th class="px-2 py-2.5">Status</th>
                <th class="px-2 py-2.5">Klaster</th>
                <th class="px-2 py-2.5">Kota</th>
                <th class="px-2 py-2.5">Aksi disarankan</th>
                <th class="px-2 py-2.5 text-right">Peluang</th>
                <th class="px-3 py-2.5 text-right">Pri</th>
              </tr>
            </thead>
            <tbody>
              {list.map((r) => (
                <tr class="border-t border-[color:var(--border-subtle)] transition-colors hover:bg-[color:var(--bg-surface-2)]/60">
                  <td class="px-3 py-2"><input type="checkbox" name="ids[]" value={r.id} class="keyword-check rounded" form="bulkForm" /></td>
                  <td class="px-3 py-2 font-medium">
                    <div class="truncate max-w-[280px]">{r.keyword}</div>
                    {r.normalizedKeyword && r.normalizedKeyword !== r.keyword.toLowerCase() && (
                      <div class="mt-0.5 truncate text-[10px] text-[color:var(--text-faint)]">= {r.normalizedKeyword}</div>
                    )}
                  </td>
                  <td class="px-2 py-2"><span class:list={[chipCls[groupOf(r.status)] ?? "chip", "text-[10px]"]} title={`db: ${r.status}`}>{STATUS_LABEL[groupOf(r.status)]}</span>{r.articleSlug && indexStage[r.articleSlug] && INDEX_BADGE[indexStage[r.articleSlug].stage] && (<span class:list={[INDEX_BADGE[indexStage[r.articleSlug].stage].cls, "ml-1 text-[10px]"]} title={`index: ${indexStage[r.articleSlug].stage}`}>{INDEX_BADGE[indexStage[r.articleSlug].stage].label}</span>)}</td>
                  <td class="px-2 py-2 text-xs">
                    {r.cluster ? <span class="chip chip-info text-[10px]">{CLUSTER_LABELS[r.cluster] ?? r.cluster}</span> : <span class="text-[color:var(--text-faint)]">—</span>}
                  </td>
                  <td class="px-2 py-2 text-xs text-[color:var(--text-muted)]">{r.city ?? <span class="text-[color:var(--text-faint)]">—</span>}</td>
                  <td class="px-2 py-2 text-xs text-[color:var(--text-secondary)]">
                    {r.suggestion ?? <span class="text-[color:var(--text-faint)]">—</span>}
                  </td>
                  <td class="px-2 py-2 text-right">
                    <div class="inline-flex items-center gap-1.5">
                      <div class="h-1 w-12 overflow-hidden rounded-full bg-[color:var(--bg-surface-2)]">
                        <div class="h-full rounded-full bg-[color:var(--brand)]" style={`width:${Math.min(100, r.opportunity / 50)}%`}></div>
                      </div>
                      <span class="font-[family-name:var(--font-mono-num)] text-[11px] font-bold">{fmtInt(r.opportunity)}</span>
                    </div>
                  </td>
                  <td class="px-3 py-2 text-right font-[family-name:var(--font-mono-num)] text-xs">{r.priority}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </form>
  )}

  {!isSuperadmin && (
    <div class="mt-4">
      {list.length === 0 ? (
        <EmptyState
          title={q || statusParam || clusterParam || cityParam ? "Tidak ada hasil" : "Belum ada keyword"}
          message={q ? "Coba kata kunci lain atau hapus filter." : "Snapshot keyword pertama jalan 05:10 WIB."}
          mascot="search"
          when="Snapshot harian 05:10 WIB dari pipeline GSC + keyword-harvester."
        />
      ) : (
        <div class="card mt-4 overflow-x-auto !p-0">
          <table class="w-full min-w-[820px] text-sm">
            <thead>
              <tr class="text-left text-[10px] uppercase tracking-[0.12em] text-[color:var(--text-faint)]">
                <th class="px-3 py-2.5">Keyword</th>
                <th class="px-2 py-2.5">Status</th>
                <th class="px-2 py-2.5">Klaster</th>
                <th class="px-2 py-2.5">Kota</th>
                <th class="px-2 py-2.5">Aksi disarankan</th>
                <th class="px-2 py-2.5 text-right">Peluang</th>
                <th class="px-3 py-2.5 text-right">Pri</th>
              </tr>
            </thead>
            <tbody>
              {list.map((r) => (
                <tr class="border-t border-[color:var(--border-subtle)]">
                  <td class="px-3 py-2 font-medium">{r.keyword}</td>
                  <td class="px-2 py-2"><span class:list={[chipCls[groupOf(r.status)] ?? "chip", "text-[10px]"]} title={`db: ${r.status}`}>{STATUS_LABEL[groupOf(r.status)]}</span>{r.articleSlug && indexStage[r.articleSlug] && INDEX_BADGE[indexStage[r.articleSlug].stage] && (<span class:list={[INDEX_BADGE[indexStage[r.articleSlug].stage].cls, "ml-1 text-[10px]"]} title={`index: ${indexStage[r.articleSlug].stage}`}>{INDEX_BADGE[indexStage[r.articleSlug].stage].label}</span>)}</td>
                  <td class="px-2 py-2 text-xs">{r.cluster ? <span class="chip chip-info text-[10px]">{CLUSTER_LABELS[r.cluster] ?? r.cluster}</span> : "—"}</td>
                  <td class="px-2 py-2 text-xs text-[color:var(--text-muted)]">{r.city ?? "—"}</td>
                  <td class="px-2 py-2 text-xs text-[color:var(--text-secondary)]">{r.suggestion ?? "—"}</td>
                  <td class="px-2 py-2 text-right">
                    <span class="font-[family-name:var(--font-mono-num)] text-[11px] font-bold">{fmtInt(r.opportunity)}</span>
                  </td>
                  <td class="px-3 py-2 text-right font-[family-name:var(--font-mono-num)] text-xs">{r.priority}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  )}

  <!-- PAGINATION -->
  {totalPages > 1 && (
    <div class="mt-4 flex items-center justify-between text-sm">
      <div class="text-xs text-[color:var(--text-muted)]">
        Halaman {pageParam} dari {totalPages} · {fmtInt(total)} total
      </div>
      <div class="flex items-center gap-1">
        <a href={linkBase({ page: pageParam > 1 ? String(pageParam - 1) : null })} class:list={["btn !py-1 text-xs", pageParam <= 1 ? "pointer-events-none opacity-40" : ""]}>
          <Icon name="chevron-right" class="rotate-180" size="xs" /> Sebelumnya
        </a>
        <span class="px-2 text-xs text-[color:var(--text-muted)]">{pageParam} / {totalPages}</span>
        <a href={linkBase({ page: pageParam < totalPages ? String(pageParam + 1) : null })} class:list={["btn !py-1 text-xs", pageParam >= totalPages ? "pointer-events-none opacity-40" : ""]}>
          Berikutnya <Icon name="chevron-right" size="xs" />
        </a>
      </div>
    </div>
  )}

  <p class="mt-3 text-[10px] text-[color:var(--text-faint)]">
    Rantai status: Pending (antre) → Artikel dibuat (draft) → On progress publish (terbit) → Publish (ter-commit + diajukan ke Google).
    Urutan default: lokal dulu (Majenang → Cilacap Raya). Snapshot enrichment sync tiap pagi via <code>/api/cron/migrate-keywords</code>.
  </p>
</Base>

<script>
  // Select-all checkbox
  const selAll = document.getElementById("selectAll") as HTMLInputElement | null;
  if (selAll) {
    selAll.addEventListener("change", () => {
      document.querySelectorAll<HTMLInputElement>(".keyword-check").forEach((cb) => (cb.checked = selAll.checked));
    });
  }
</script>
