---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import { getRequestTenant, series, sumRange } from "../lib/data";
import { fmtInt, fmtRp } from "../lib/insights";
import { and, eq, gte, sql } from "drizzle-orm";
import { getDb } from "../lib/db";
import { leadEvents } from "../../drizzle/schema";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

const mSpend = sumRange(await series(tenant.id, "meta_ads", "spend", 30), 30, 0);
const gSpend = sumRange(await series(tenant.id, "google_ads", "spend", 30), 30, 0);
const mChats = Math.round(sumRange(await series(tenant.id, "meta_ads", "leads", 30), 30, 0));
const gConv = Math.round(sumRange(await series(tenant.id, "google_ads", "conversions", 30), 30, 0));
const orgClicks = Math.round(sumRange(await series(tenant.id, "seo", "clicks", 30), 30, 0));
const leadEventsCount = Math.round(sumRange(await series(tenant.id, "wa", "leads", 30), 30, 0));

const since = new Date();
since.setUTCDate(since.getUTCDate() - 30);
const db = getDb();
const dealRows = await db
  .select({ source: leadEvents.source, sum: sql<number>`COALESCE(SUM(${leadEvents.dealValue}), 0)` })
  .from(leadEvents)
  .where(and(eq(leadEvents.tenantId, tenant.id), eq(leadEvents.status, "deal"), gte(leadEvents.ts, since)))
  .groupBy(leadEvents.source);
const revenue = dealRows.reduce((a, r) => a + Number(r.sum ?? 0), 0);

const totalSpend = mSpend + gSpend;
const totalLeads = mChats + gConv;
const cpa = totalLeads ? Math.round(totalSpend / totalLeads) : 0;
const organicValue = orgClicks * 1500; // estimasi nilai SEO vs Meta

// Narasi WOW
let headline = "";
if (totalSpend === 0 && totalLeads === 0 && orgClicks === 0) {
  headline = "Belum ada data — mesin pengumpul sudah jalan, angka terisi otomatis.";
} else if (totalSpend === 0) {
  headline = `Bulan ini Rp0 iklan → ${fmtInt(orgClicks)} klik organik gratis. Saat P9 jalan, baris ini jadi cerita ROI utuh.`;
} else if (orgClicks > 0) {
  const ratio = Math.round((orgClicks / (orgClicks + totalLeads)) * 100);
  headline = `${ratio}% lead bulan ini datang tanpa bayar iklan — mesin SEO Anda jalan. ${revenue > 0 ? `Revenue Deal tercatat ${fmtRp(revenue)} dari ${dealRows.length} deal.` : ""}`;
} else {
  headline = `Bulan ini ${fmtRp(totalSpend)} iklan → ${fmtInt(totalLeads)} lead/konversi.`;
}
---
<Base title="ROI Lintas Channel" tenantName={tenant.name}>
  <div class="relative overflow-hidden rounded-2xl px-6 py-5 grain" style="background: linear-gradient(135deg, #1C1917 0%, #292524 100%); color: #fff;">
    <div class="hazard-stripe absolute inset-x-0 top-0"></div>
    <div class="pointer-events-none absolute -bottom-20 -right-20 h-80 w-80 rounded-full" style="background: radial-gradient(circle, rgb(37 211 102 / 0.25), transparent 70%)"></div>
    <div class="pointer-events-none absolute -top-20 -left-20 h-72 w-72 rounded-full" style="background: radial-gradient(circle, rgb(220 38 38 / 0.20), transparent 70%)"></div>
    <div class="relative z-10 max-w-2xl">
      <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#FACC15]">Ringkasan untuk Anda</div>
      <h2 class="mt-2 text-display text-3xl sm:text-4xl">Duit Anda,<br /><span style="color:#FACC15">jadi apa?</span></h2>
      <p class="mt-3 text-base text-white/85">{headline}</p>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <StatCard label="Total iklan 30 hari" value={fmtRp(totalSpend)} hint="Meta + Google" />
    <StatCard label="Lead/konversi iklan" value={fmtInt(totalLeads)} hint="dari Meta + Google" />
    <StatCard label="Klik organik gratis" value={fmtInt(orgClicks)} hint="dari Google Search" />
    <StatCard label="Biaya per lead" value={totalLeads ? fmtRp(cpa) : "—"} hint={totalLeads ? "CPA gabungan" : "menunggu lead pertama"} warn={cpa > 500000} />
  </div>

  {revenue > 0 && (
    <div class="card mt-4 flex items-center gap-4 px-5 py-4" style="background: linear-gradient(135deg, rgb(16 185 129 / 0.10), transparent);">
      <div class="grid h-12 w-12 place-items-center rounded-xl bg-[color:var(--success-soft)] text-[color:var(--success)]">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </div>
      <div class="flex-1">
        <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Revenue Deal tercatat</div>
        <div class="font-[family-name:var(--font-display)] text-2xl font-extrabold text-[color:var(--success)]">{fmtRp(revenue)}</div>
        <div class="text-[11px] text-[color:var(--text-muted)]">{dealRows.length} deal · diinput manual di pipeline</div>
      </div>
      <a href="/leads" class="btn btn-ghost text-xs">Lihat pipeline →</a>
    </div>
  )}

  {organicValue > 0 && (
    <div class="card mt-4 p-5" style="background: linear-gradient(135deg, rgb(14 165 233 / 0.08), transparent);">
      <div class="flex items-center gap-3">
        <div class="grid h-12 w-12 place-items-center rounded-xl bg-[color:var(--info-soft)] text-[color:var(--info)]">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg>
        </div>
        <div class="flex-1">
          <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Kontribusi SEO ke ROI</div>
          <div class="font-[family-name:var(--font-display)] text-2xl font-extrabold">{fmtInt(orgClicks)} klik gratis = {fmtRp(organicValue)}</div>
          <div class="text-[11px] text-[color:var(--text-muted)]">Estimasi biaya Meta kalau klik sebanyak ini harus dibayar · CPC benchmark Rp1.500</div>
        </div>
      </div>
    </div>
  )}

  <div class="mt-4 grid gap-3 lg:grid-cols-2">
    <div class="card p-5">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="grid h-7 w-7 place-items-center rounded-md text-xs font-bold text-white" style="background:#0081fb">M</span>
          <span class="font-[family-name:var(--font-heading)] text-sm font-bold">Meta Ads</span>
        </div>
        <span class="chip text-[10px]">30 hari</span>
      </div>
      <div class="mt-3 grid grid-cols-3 gap-2 text-center">
        <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{fmtRp(mSpend)}</div><div class="text-[10px] text-[color:var(--text-faint)]">spend</div></div>
        <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{fmtInt(mChats)}</div><div class="text-[10px] text-[color:var(--text-faint)]">chat</div></div>
        <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{mChats ? fmtRp(Math.round(mSpend / mChats)) : "—"}</div><div class="text-[10px] text-[color:var(--text-faint)]">CPA</div></div>
      </div>
      <div class="mt-3 h-2 overflow-hidden rounded-full bg-[color:var(--bg-surface-2)]">
        <div class="h-full" style="width:85%;background:linear-gradient(90deg,#0081fb,#0ea5e9)"></div>
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="grid h-7 w-7 place-items-center rounded-md text-xs font-bold" style="background:#FACC15;color:#1C1917">G</span>
          <span class="font-[family-name:var(--font-heading)] text-sm font-bold">Google Ads</span>
        </div>
        <span class="chip text-[10px]">30 hari</span>
      </div>
      <div class="mt-3 grid grid-cols-3 gap-2 text-center">
        <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{fmtRp(gSpend)}</div><div class="text-[10px] text-[color:var(--text-faint)]">spend</div></div>
        <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{fmtInt(gConv)}</div><div class="text-[10px] text-[color:var(--text-faint)]">konversi</div></div>
        <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{gConv ? fmtRp(Math.round(gSpend / gConv)) : "—"}</div><div class="text-[10px] text-[color:var(--text-faint)]">CPA</div></div>
      </div>
      <div class="mt-3 h-2 overflow-hidden rounded-full bg-[color:var(--bg-surface-2)]">
        <div class="h-full" style="width:0%;background:linear-gradient(90deg,#FACC15,#f97316)"></div>
      </div>
    </div>
  </div>

  <div class="card mt-4 p-5 text-sm">
    <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Cara baca</div>
    <p class="mt-1 text-[color:var(--text-secondary)]">
      <strong class="text-[color:var(--text-primary)]">Iklan = bayar, organik = gratis.</strong> Kalau biaya per lead iklan lebih mahal dari nilai deal,
      berarti iklan belum efisien. Revenue Deal tercatat dari input manual pipeline (<a class="text-[color:var(--info)] hover:underline" href="/leads">/leads</a>).
      Kontribusi SEO = klik gratis × Rp1.500 (CPC benchmark Meta Indonesia).
    </p>
  </div>
</Base>
