---
import Base from "../layouts/Base.astro";
import StatCard from "../components/StatCard.astro";
import BarChartLC from "../components/BarChartLC.svelte";
import InfoHint from "../components/InfoHint.astro";
import { getRequestTenant, series, sumRange } from "../lib/data";
import { fmtInt, fmtRp } from "../lib/insights";
import { and, eq, gte, sql } from "drizzle-orm";
import { getDb } from "../lib/db";
import { leadEvents } from "../../drizzle/schema";

const user = Astro.locals.user!;
const tenant = await getRequestTenant(Astro.url.host, Astro.url.pathname, Astro.url.searchParams, user.role === "superadmin");
if (!tenant) throw new Error("Tenant tidak ditemukan");

const mSpendS = await series(tenant.id, "meta_ads", "spend", 30);
const mClicksS = await series(tenant.id, "meta_ads", "clicks", 30);
const mChatsS = await series(tenant.id, "meta_ads", "leads", 30);
const mRepliedS = await series(tenant.id, "meta_ads", "chat_replied", 30);
const gSpend = sumRange(await series(tenant.id, "google_ads", "spend", 30), 30, 0);
const gConv = Math.round(sumRange(await series(tenant.id, "google_ads", "conversions", 30), 30, 0));
const orgClicks = Math.round(sumRange(await series(tenant.id, "seo", "clicks", 30), 30, 0));

const mSpend = sumRange(mSpendS, 30, 0);
const mClicks = Math.round(sumRange(mClicksS, 30, 0));
const mChats = Math.round(sumRange(mChatsS, 30, 0));
const mReplied = Math.round(sumRange(mRepliedS, 30, 0));

const since = new Date();
since.setUTCDate(since.getUTCDate() - 30);
const db = getDb();
const dealAgg = await db
  .select({ n: sql<number>`COUNT(*)`, sum: sql<number>`COALESCE(SUM(${leadEvents.dealValue}), 0)` })
  .from(leadEvents)
  .where(and(eq(leadEvents.tenantId, tenant.id), eq(leadEvents.status, "deal"), gte(leadEvents.ts, since)));
const dealCount = Number(dealAgg[0]?.n ?? 0);
const revenue = Number(dealAgg[0]?.sum ?? 0);
const dealRows = await db
  .select({ source: leadEvents.source, sum: sql<number>`COALESCE(SUM(${leadEvents.dealValue}), 0)` })
  .from(leadEvents)
  .where(and(eq(leadEvents.tenantId, tenant.id), eq(leadEvents.status, "deal"), gte(leadEvents.ts, since)))
  .groupBy(leadEvents.source);

// S1: hitung deal_value nyata vs estimasi (untuk bintang penanda transparansi).
// Ambil list deal dengan dealValue riil > 0 (estimator tidak dipakai)
const dealReal = await db
  .select({ v: leadEvents.dealValue })
  .from(leadEvents)
  .where(and(eq(leadEvents.tenantId, tenant.id), eq(leadEvents.status, "deal"), gte(leadEvents.ts, since)));
const dealsWithValue = dealReal.filter((r) => r.v != null && r.v > 0).length;
const hasEstimate = dealCount - dealsWithValue;

const totalSpend = mSpend + gSpend;
const totalLeads = mChats + gConv;
const cpa = totalLeads ? Math.round(totalSpend / totalLeads) : 0;
const roas = totalSpend > 0 && revenue > 0 ? revenue / totalSpend : 0;
const organicValue = orgClicks * 1500;

const pct = (a: number, b: number) => (b > 0 ? `${((a / b) * 100).toFixed(a / b < 0.1 ? 1 : 0)}%` : "—");

// Funnel Meta: belanja → klik → chat → dibalas → deal → revenue
// Tiap stage punya `source` ringkas untuk chip InfoHint.
const funnel: { label: string; value: string; sub: string; conv: string | null; source: string }[] = [
  { label: "Belanja iklan", value: fmtRp(mSpend), sub: "30 hari · ACTIVE", conv: null, source: "Meta Insights · 05:30 WIB" },
  { label: "Klik iklan", value: fmtInt(mClicks), sub: `CPC ${mClicks ? fmtRp(Math.round(mSpend / mClicks)) : "—"}`, conv: pct(mClicks, 0), source: "Meta Insights · 05:30 WIB" },
  { label: "Chat WhatsApp", value: fmtInt(mChats), sub: `CPA ${mChats ? fmtRp(Math.round(mSpend / mChats)) : "—"} · chat dari iklan (CTWA, langsung ke WA CS, tidak lewat website)`, conv: pct(mChats, mClicks), source: "Meta Insights · 05:30 WIB" },
  { label: "Dibalas", value: fmtInt(mReplied), sub: "CS merespons chat WA", conv: pct(mReplied, mChats), source: "Meta Insights · 05:30 WIB" },
  { label: "Deal", value: fmtInt(dealCount), sub: "tercatat di pipeline", conv: pct(dealCount, mReplied), source: "Pipeline /leads · manual" },
  { label: "Revenue", value: fmtRp(revenue), sub: roas > 0 ? `ROAS ${roas.toFixed(1)}×` : "nilai deal", conv: null, source: `Pipeline ${dealsWithValue}/${dealCount} nilai riil · ${hasEstimate > 0 ? `lainnya ≈ estimasi` : "semua riil"}` },
];

let headline = "";
if (totalSpend === 0 && totalLeads === 0 && orgClicks === 0) {
  headline = "Belum ada data. Sistem pengumpul sudah berjalan dan angka akan terisi otomatis.";
} else if (roas > 0) {
  headline = `Setiap Rp1 belanja iklan menghasilkan Rp${roas.toFixed(1)} pendapatan tercatat. ${fmtInt(dealCount)} transaksi dari ${fmtInt(mChats)} percakapan WhatsApp (chat dari iklan Meta — klik langsung ke WA CS, tidak lewat website).`;
} else if (totalSpend === 0) {
  headline = `Tanpa belanja iklan, ${fmtInt(orgClicks)} kunjungan organik senilai ${fmtRp(organicValue)} datang gratis dari Google.`;
} else if (dealCount > 0 && revenue === 0) {
  // S1: deal tercatat tapi revenue Rp0 → kemungkinan nilai belum diinput / auto-estimasi kosong.
  headline = `${fmtRp(totalSpend)} belanja iklan menghasilkan ${fmtInt(totalLeads)} prospek. ${fmtInt(dealCount)} transaksi tercatat, ${dealsWithValue} di antaranya sudah punya nilai riil. ${hasEstimate > 0 ? `Sisanya (${fmtInt(hasEstimate)} deal) diestimasi otomatis — tim bisa update manual di /leads.` : "Tandai nilai deal di pipeline agar ROAS tampil."}`;
} else {
  headline = `${fmtRp(totalSpend)} belanja iklan menghasilkan ${fmtInt(totalLeads)} prospek. ${fmtInt(mReplied)} di antaranya merespons — catat nilai transaksinya di pipeline agar ROAS tampil di sini.`;
}
---
<Base title="Hasil Investasi Iklan" tenantName={tenant.name}>
  <div class="relative overflow-hidden rounded-2xl px-6 py-5 grain" style="background: linear-gradient(135deg, #1C1917 0%, #292524 100%); color: #fff;">
    <div class="hazard-stripe absolute inset-x-0 top-0"></div>
    <div class="pointer-events-none absolute -bottom-20 -right-20 h-80 w-80 rounded-full" style="background: radial-gradient(circle, rgb(37 211 102 / 0.25), transparent 70%)"></div>
    <div class="pointer-events-none absolute -top-20 -left-20 h-72 w-72 rounded-full" style="background: radial-gradient(circle, rgb(220 38 38 / 0.20), transparent 70%)"></div>
    <div class="relative z-10 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
      <div class="max-w-2xl">
        <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#FACC15]">Pengembalian investasi · 30 hari</div>
        <h2 class="mt-2 text-display text-2xl sm:text-3xl">Setiap rupiah tercatat hasilnya.</h2>
        <p class="mt-2 max-w-xl text-sm text-white/85">{headline}</p>
      </div>
      <div class="grid gap-2 sm:gap-3">
        <div class="rounded-xl border border-white/15 px-4 py-3">
          <div class="flex items-center gap-1.5 text-[10px] text-white/55 uppercase tracking-[0.12em]">
            <span>ROAS</span>
            <InfoHint source={roas > 0 ? "Pendapatan ÷ belanja" : "Menunggu deal"} fresh={roas > 0 ? "5 menit lalu · realtime" : "auto-update tiap dealsync"} tooltip="ROAS baru tampil setelah ada deal dengan nilai transaksi riil. Estimasi tidak dihitung agar ROAS tidak menyesatkan." variant="info" />
          </div>
          <div class="font-[family-name:var(--font-display)] text-3xl font-extrabold" style="color:#34d399">{roas > 0 ? `${roas.toFixed(1)}×` : "—"}</div>
          <div class="text-[10px] text-white/55">
            {roas > 0
              ? "pendapatan ÷ belanja iklan"
              : hasEstimate > 0
                ? `${hasEstimate} deal masih estimasi — buka /leads untuk isi nilai riil`
                : "terisi setelah ada deal bernilai"}
          </div>
        </div>
        <div class="rounded-xl border border-white/15 px-4 py-3">
          <div class="flex items-center gap-1.5 text-[10px] text-white/55 uppercase tracking-[0.12em]">
            <span>Biaya per prospek</span>
            <InfoHint source="Meta + Google" fresh="05:30 · 05:35 WIB" tooltip={`Total spend 30h ÷ total leads (Meta ${fmtInt(mChats)} + Google ${fmtInt(gConv)} chat/konversi).`} variant="info" />
          </div>
          <div class="font-[family-name:var(--font-display)] text-3xl font-extrabold">{totalLeads ? fmtRp(cpa) : "—"}</div>
          <div class="text-[10px] text-white/55">gabungan Meta + Google</div>
        </div>
      </div>
    </div>
  </div>

  <!-- FUNNEL -->
  <div class="card mt-4 overflow-hidden">
    <div class="flex items-center justify-between border-b border-[color:var(--border-subtle)] px-5 py-3">
      <h2 class="font-[family-name:var(--font-heading)] text-sm font-bold">Alur konversi <span class="font-[family-name:var(--font-body)] text-xs font-normal text-[color:var(--text-faint)]">dari belanja hingga pendapatan</span></h2>
      <span class="chip text-[10px]">Meta Ads · 30 hari</span>
    </div>
    <div class="grid grid-cols-2 gap-2 p-4 sm:grid-cols-3 lg:grid-cols-6">
      {funnel.map((f, i) => (
        <div class="relative rounded-xl border border-[color:var(--border-subtle)] bg-[color:var(--bg-surface-2)]/50 p-3">
          {f.conv && (
            <span class="absolute -top-2 left-3 rounded-full bg-[color:var(--success)] px-1.5 py-px text-[9px] font-bold text-white">{f.conv}</span>
          )}
          <div class="flex items-center justify-between gap-1">
            <span class="text-[10px] font-semibold uppercase tracking-[0.1em] text-[color:var(--text-faint)]">{String(i + 1).padStart(2, "0")} · {f.label}</span>
            <InfoHint source={f.source} variant="info" />
          </div>
          <div class="mt-1 font-[family-name:var(--font-display)] text-xl font-extrabold tracking-tight">{f.value}</div>
          <div class="mt-0.5 text-[10px] leading-snug text-[color:var(--text-muted)]">{f.sub}</div>
        </div>
      ))}
    </div>
    <p class="border-t border-[color:var(--border-subtle)] px-5 py-2.5 text-[11px] text-[color:var(--text-faint)]">Persentase hijau = tingkat lolos ke tahap berikutnya. Deal dan revenue tercatat manual di <a class="text-[color:var(--info)] hover:underline" href="/leads">pipeline</a>.</p>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <StatCard label="Total belanja 30 hari" value={fmtRp(totalSpend)} hint="Meta + Google · 05:30 + 05:35 WIB" source={"Σ 30 hari: Meta Graph insights (05:30) + Google Ads API (05:35)"} />
    <StatCard label="Prospek dari iklan" value={fmtInt(totalLeads)} hint="Meta CTWA (langsung ke WA, lewat website) · bukan /leads" ok={totalLeads > 0} source={"Meta chat_started + Google Ads conversions. Chat dari iklan TIDAK lewat website — masuk langsung ke WA CS."} />
    <StatCard label="Kunjungan organik" value={fmtInt(orgClicks)} hint={`senilai ${fmtRp(organicValue)} · GSC 05:00`} ok={orgClicks > 0} source={"GSC clicks 30h · estimasi nilai pakai CPC Meta acuan Rp1.500 (pembanding kasar)"} />
    <StatCard label="Biaya per prospek" value={totalLeads ? fmtRp(cpa) : "—"} hint="gabungan semua channel · benchmark ≤Rp15rb" warn={cpa > 500000} ok={totalLeads > 0 && cpa <= 15000} source={"Total spend ÷ total leads · blended Meta+Google · CTWA Indonesia sehat ≤Rp15rb/chat"} />
  </div>

  {revenue > 0 && (
    <div class="card mt-4 flex items-center gap-4 px-5 py-4" style="background: linear-gradient(135deg, rgb(16 185 129 / 0.10), transparent);">
      <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-[color:var(--success-soft)] text-[color:var(--success)]">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </div>
      <div class="flex-1">
        <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Pendapatan tercatat</div>
        <div class="font-[family-name:var(--font-display)] text-2xl font-extrabold text-[color:var(--success)]">{fmtRp(revenue)}</div>
        <div class="text-[11px] text-[color:var(--text-muted)]">{fmtInt(dealCount)} transaksi · per sumber: {dealRows.map((r) => `${r.source ?? "langsung"} ${fmtRp(Number(r.sum ?? 0))}`).join(" · ")}</div>
      </div>
      <a href="/leads" class="btn btn-ghost shrink-0 text-xs">Pipeline →</a>
    </div>
  )}

  {organicValue > 0 && (
    <div class="card mt-4 p-5" style="background: linear-gradient(135deg, rgb(14 165 233 / 0.08), transparent);">
      <div class="flex items-center gap-3">
        <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-[color:var(--info-soft)] text-[color:var(--info)]">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg>
        </div>
        <div class="flex-1">
          <div class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Kontribusi kunjungan organik</div>
          <div class="font-[family-name:var(--font-display)] text-2xl font-extrabold">{fmtInt(orgClicks)} kunjungan = {fmtRp(organicValue)}</div>
          <div class="text-[11px] text-[color:var(--text-muted)]">Estimasi biaya apabila kunjungan sebanyak ini dibeli melalui Meta · CPC acuan Rp1.500</div>
        </div>
      </div>
    </div>
  )}

  <div class="mt-4 grid gap-3 lg:grid-cols-2">
    <div class="card p-5">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="grid h-7 w-7 place-items-center rounded-md text-xs font-bold text-white" style="background:#0081fb">M</span>
          <span class="font-[family-name:var(--font-heading)] text-sm font-bold">Meta Ads</span>
        </div>
        <span class="chip text-[10px]">30 hari</span>
      </div>
      <div class="mt-3 grid grid-cols-3 gap-2 text-center">
        <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{fmtRp(mSpend)}</div><div class="text-[10px] text-[color:var(--text-faint)]">belanja</div></div>
        <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{fmtInt(mChats)}</div><div class="text-[10px] text-[color:var(--text-faint)]">chat</div></div>
        <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{mChats ? fmtRp(Math.round(mSpend / mChats)) : "—"}</div><div class="text-[10px] text-[color:var(--text-faint)]">CPA</div></div>
      </div>
      <div class="mt-3">
        <div class="mb-1 text-[10px] text-[color:var(--text-faint)]">Belanja harian</div>
        <BarChartLC data={mSpendS.slice(-14).map((p) => ({ label: p.date.slice(5), value: Math.round(p.value) }))} height={140} barClass="fill-[#0081fb]" client:visible />
      </div>
    </div>
    <div class="card p-5">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="grid h-7 w-7 place-items-center rounded-md text-xs font-bold" style="background:#FACC15;color:#1C1917">G</span>
          <span class="font-[family-name:var(--font-heading)] text-sm font-bold">Google Ads</span>
        </div>
        <span class="chip text-[10px]">30 hari</span>
      </div>
      {gSpend > 0 ? (
        <div class="mt-3 grid grid-cols-3 gap-2 text-center">
          <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{fmtRp(gSpend)}</div><div class="text-[10px] text-[color:var(--text-faint)]">belanja</div></div>
          <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{fmtInt(gConv)}</div><div class="text-[10px] text-[color:var(--text-faint)]">konversi</div></div>
          <div><div class="font-[family-name:var(--font-mono-num)] text-lg font-extrabold">{gConv ? fmtRp(Math.round(gSpend / gConv)) : "—"}</div><div class="text-[10px] text-[color:var(--text-faint)]">CPA</div></div>
        </div>
      ) : (
        <div class="mt-3 rounded-lg bg-[color:var(--bg-surface-2)]/60 p-4 text-sm text-[color:var(--text-muted)]">
          Siap aktif — campaign pertama menunggu perintah Bos. Tracker GA4 sudah online, data akan muncul otomatis begitu campaign pertama jalan.
        </div>
      )}
    </div>
  </div>

  <div class="card mt-4 p-5 text-sm">
    <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-[color:var(--text-faint)]">Panduan membaca</div>
    <p class="mt-1 leading-relaxed text-[color:var(--text-secondary)]">
      <strong class="text-[color:var(--text-primary)]">Iklan berbayar, kunjungan organik gratis.</strong> Apabila biaya per prospek melebihi rata-rata nilai transaksi,
      efisiensi iklan perlu ditinjau. Nilai transaksi dicatat manual di <a class="text-[color:var(--info)] hover:underline" href="/leads">pipeline</a>;
      setelah ada, ROAS tampil otomatis di bagian atas halaman ini.
    </p>
  </div>
</Base>
