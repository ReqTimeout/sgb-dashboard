---
import Base from "../layouts/Base.astro";
const next = Astro.url.searchParams.get("next") ?? "/";
const err = Astro.url.searchParams.get("err");
---
<Base title="Masuk">
  <div class="mx-auto max-w-sm rounded-2xl border border-slate-200 bg-white p-6">
    <h1 class="font-heading text-xl font-bold">Masuk Dashboard</h1>
    {err && <p class="mt-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">Email atau password salah.</p>}
    <form method="post" action="/api/auth/login" class="mt-4 space-y-3">
      <input type="hidden" name="next" value={next} />
      <label class="block text-sm">
        <span class="text-slate-500">Email</span>
        <input name="email" type="email" required autocomplete="username"
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-safety-400 focus:outline-none" />
      </label>
      <label class="block text-sm">
        <span class="text-slate-500">Password</span>
        <input name="password" type="password" required autocomplete="current-password"
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-safety-400 focus:outline-none" />
      </label>
      <button class="w-full rounded-lg bg-brand-600 py-2 font-heading font-bold text-white hover:bg-brand-700" type="submit">
        Masuk
      </button>
    </form>
  </div>
</Base>
