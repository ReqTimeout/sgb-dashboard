---
import Base from "../layouts/Base.astro";
import { and, desc, eq, gte } from "drizzle-orm";
import { getDb } from "../lib/db";
import { dailyMetrics, leadEvents, notesInternal, tenants } from "../../drizzle/schema";
import { fmtInt } from "../lib/insights";

const user = Astro.locals.user!;
if (user.role !== "superadmin") throw new Error("Khusus agency");
const db = getDb();
const allTenants = await db.select().from(tenants);

function isoAgo(days: number): string {
  const d = new Date();
  d.setUTCDate(d.getUTCDate() - days);
  return d.toISOString().slice(0, 10);
}

async function tenantCards() {
  const out: { slug: string; name: string; clicks30: number; leads30: number }[] = [];
  for (const t of allTenants) {
    const clicks = await db
      .select({ v: dailyMetrics.valueNum })
      .from(dailyMetrics)
      .where(
        and(
          eq(dailyMetrics.tenantId, t.id),
          eq(dailyMetrics.channel, "seo"),
          eq(dailyMetrics.metric, "clicks"),
          gte(dailyMetrics.date, isoAgo(30)),
        ),
      );
    const leads = await db
      .select({ id: leadEvents.id })
      .from(leadEvents)
      .where(and(eq(leadEvents.tenantId, t.id), gte(leadEvents.ts, new Date(isoAgo(30) + "T00:00:00Z"))));
    out.push({
      slug: t.slug,
      name: t.name,
      clicks30: Math.round(clicks.reduce((a, r) => a + (r.v ?? 0), 0)),
      leads30: leads.length,
    });
  }
  return out;
}
const cards = await tenantCards();
const notes = await db.select().from(notesInternal).orderBy(desc(notesInternal.createdAt)).limit(10);
---
<Base title="HQ Overview">
  <h1 class="font-heading text-2xl font-bold tracking-tight">HQ Overview <span class="font-body text-sm font-normal text-slate-400">agency only</span></h1>
  <p class="mt-1 text-sm text-slate-500">Semua klien dalam satu layar.</p>

  <div class="mt-6 grid gap-3 sm:grid-cols-2">
    {cards.map((c) => (
      <a href={`/?tenant=${c.slug}`} class="rounded-2xl border border-slate-200 bg-white p-4 hover:shadow-md">
        <div class="font-heading font-bold">{c.name} <span class="font-body text-xs font-normal text-slate-400">{c.slug}</span></div>
        <div class="mt-2 flex gap-4 text-sm">
          <div><span class="font-mono-num font-bold">{fmtInt(c.clicks30)}</span> <span class="text-slate-400">klik 30 hari</span></div>
          <div><span class="font-mono-num font-bold">{fmtInt(c.leads30)}</span> <span class="text-slate-400">lead</span></div>
        </div>
      </a>
    ))}
  </div>

  <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-4">
    <h2 class="font-heading font-bold">Catatan internal</h2>
    <form method="post" action="/api/notes" class="mt-2 flex gap-2">
      <input name="tenant_slug" placeholder="slug tenant" class="w-32 rounded-lg border border-slate-300 px-3 py-2 text-sm" required />
      <input name="body" placeholder="Tulis catatan…" class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" required />
      <button class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-bold text-white" type="submit">Simpan</button>
    </form>
    <ul class="mt-3 space-y-2 text-sm">
      {notes.length === 0 && <li class="text-slate-400">Belum ada catatan.</li>}
      {notes.map((n) => (
        <li class="rounded-lg bg-slate-50 px-3 py-2"><span class="text-xs text-slate-400">tenant #{n.tenantId} · {n.author} · {String(n.createdAt).slice(0, 10)}</span><br />{n.body}</li>
      ))}
    </ul>
  </div>
</Base>
