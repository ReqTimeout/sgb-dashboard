---
import Base from "../layouts/Base.astro";
import { and, desc, eq, gte } from "drizzle-orm";
import { getDb } from "../lib/db";
import { dailyMetrics, leadEvents, notesInternal, tenants } from "../../drizzle/schema";
import { fmtInt } from "../lib/insights";

const user = Astro.locals.user!;
if (user.role !== "superadmin") throw new Error("Khusus agency");
const db = getDb();
const allTenants = await db.select().from(tenants);

function isoAgo(days: number): string {
  const d = new Date();
  d.setUTCDate(d.getUTCDate() - days);
  return d.toISOString().slice(0, 10);
}

const cards: { slug: string; name: string; clicks30: number; leads30: number }[] = [];
for (const t of allTenants) {
  const clicks = await db.select({ v: dailyMetrics.valueNum }).from(dailyMetrics).where(
    and(eq(dailyMetrics.tenantId, t.id), eq(dailyMetrics.channel, "seo"), eq(dailyMetrics.metric, "clicks"), gte(dailyMetrics.date, isoAgo(30)))
  );
  const leads = await db.select({ id: leadEvents.id }).from(leadEvents).where(
    and(eq(leadEvents.tenantId, t.id), gte(leadEvents.ts, new Date(isoAgo(30) + "T00:00:00Z")))
  );
  cards.push({ slug: t.slug, name: t.name, clicks30: Math.round(clicks.reduce((a, r) => a + (r.v ?? 0), 0)), leads30: leads.length });
}
const notes = await db.select().from(notesInternal).orderBy(desc(notesInternal.createdAt)).limit(10);
const totals = cards.reduce((a, c) => ({ clicks: a.clicks + c.clicks30, leads: a.leads + c.leads30 }), { clicks: 0, leads: 0 });
---
<Base title="HQ Overview" tenantName="Agency">
  <div class="relative overflow-hidden rounded-2xl px-6 py-7 grain" style="background: linear-gradient(135deg, #0B0F17 0%, #1C1917 100%); color: #fff;">
    <div class="hazard-stripe absolute inset-x-0 top-0"></div>
    <div class="pointer-events-none absolute right-6 top-6 hidden h-32 w-32 rounded-full sm:block" style="background: radial-gradient(circle, rgb(37 211 102 / 0.35), transparent 70%)"></div>
    <div class="relative z-10 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
      <div>
        <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#34d399]">Agency Beriklan</div>
        <div class="mt-1 text-display text-3xl sm:text-4xl">Semua klien,<br />dalam satu layar.</div>
      </div>
      <div class="flex gap-2 text-xs">
        <div class="rounded-lg border border-white/15 px-3 py-2"><div class="text-[10px] text-white/50 uppercase tracking-[0.12em]">Klien</div><div class="font-[family-name:var(--font-mono-num)] text-2xl font-extrabold count-up">{cards.length}</div></div>
        <div class="rounded-lg border border-white/15 px-3 py-2"><div class="text-[10px] text-white/50 uppercase tracking-[0.12em]">Klik 30h</div><div class="font-[family-name:var(--font-mono-num)] text-2xl font-extrabold count-up" style="color:#FACC15">{fmtInt(totals.clicks)}</div></div>
        <div class="rounded-lg border border-white/15 px-3 py-2"><div class="text-[10px] text-white/50 uppercase tracking-[0.12em]">Lead 30h</div><div class="font-[family-name:var(--font-mono-num)] text-2xl font-extrabold count-up" style="color:#34d399">{fmtInt(totals.leads)}</div></div>
      </div>
    </div>
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map((c) => (
      <a href={`/?tenant=${c.slug}`} class="card group block p-5">
        <div class="flex items-start justify-between">
          <div>
            <div class="font-[family-name:var(--font-heading)] text-sm font-bold transition-colors group-hover:text-[color:var(--brand)]">{c.name}</div>
            <div class="mt-0.5 text-[10px] uppercase tracking-[0.12em] text-[color:var(--text-faint)]">{c.slug}</div>
          </div>
          <svg class="h-4 w-4 text-[color:var(--text-faint)] transition-transform group-hover:translate-x-0.5 group-hover:text-[color:var(--brand)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
        <div class="divider-fade my-3"></div>
        <div class="grid grid-cols-2 gap-2">
          <div><div class="font-[family-name:var(--font-mono-num)] text-xl font-extrabold">{fmtInt(c.clicks30)}</div><div class="text-[10px] text-[color:var(--text-faint)]">klik /30h</div></div>
          <div><div class="font-[family-name:var(--font-mono-num)] text-xl font-extrabold" class:list={[c.leads30 > 0 ? "text-[color:var(--success)]" : ""]}>{fmtInt(c.leads30)}</div><div class="text-[10px] text-[color:var(--text-faint)]">lead /30h</div></div>
        </div>
      </a>
    ))}
    {cards.length === 0 && <div class="card p-8 text-center text-sm text-[color:var(--text-faint)]">Belum ada klien.</div>}
  </div>

  <div class="card mt-4 overflow-hidden">
    <div class="flex items-center justify-between border-b border-[color:var(--border-subtle)] px-5 py-3">
      <h2 class="font-[family-name:var(--font-heading)] text-sm font-bold">Catatan internal</h2>
      <span class="chip text-[10px]">{notes.length}</span>
    </div>
    <form method="post" action="/api/notes" class="flex flex-col gap-2 px-5 py-3 sm:flex-row">
      <select name="tenant_slug" required class="w-full !py-1.5 text-sm sm:w-40">
        <option value="">Tenant…</option>
        {allTenants.map((t) => <option value={t.slug}>{t.name}</option>)}
      </select>
      <input name="body" placeholder="Tulis catatan…" required class="flex-1 !py-1.5 text-sm" />
      <button class="btn btn-primary !py-1.5 text-sm" type="submit">Simpan</button>
    </form>
    <ul class="divide-y divide-[color:var(--border-subtle)]">
      {notes.length === 0 && <li class="px-5 py-4 text-sm text-[color:var(--text-faint)]">Belum ada catatan.</li>}
      {notes.map((n) => (
        <li class="px-5 py-3 text-sm">
          <div class="flex items-center gap-2 text-[11px] text-[color:var(--text-faint)]">
            <span>{n.author}</span>
            <span>·</span>
            <span>{String(n.createdAt).slice(0, 16).replace("T", " ")}</span>
            <span>·</span>
            <span>tenant #{n.tenantId}</span>
          </div>
          <p class="mt-1 text-[color:var(--text-secondary)]">{n.body}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
