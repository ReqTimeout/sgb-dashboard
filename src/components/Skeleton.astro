---
interface Props { class?: string; rows?: number; width?: string; height?: string; rounded?: string; }
const { class: cls = "", rows = 1, width = "100%", height = "0.75rem", rounded = "6px" } = Astro.props;
---
<div class={`flex flex-col gap-1.5 ${cls}`}>
  {Array.from({ length: rows }).map(() => (
    <div class="skeleton" style={`width:${width};height:${height};border-radius:${rounded}`}></div>
  ))}
</div>
