---
interface Group { label: string; items: { href: string; label: string; icon: string; superadmin?: boolean }[]; }
interface Props {
  current: string;
  user: { email: string; role: string } | null;
  tenantName: string;
  alertCount?: number;
}
const { current, user, tenantName, alertCount = 0 } = Astro.props;

const groups: Group[] = [
  { label: "Ringkasan", items: [{ href: "/", label: "Pagi ini", icon: "home" }] },
  {
    label: "SEO",
    items: [
      { href: "/seo", label: "Performa", icon: "chart" },
      { href: "/ranking", label: "Ranking", icon: "trophy" },
      { href: "/konten", label: "Konten", icon: "doc" },
      { href: "/keywords", label: "Keyword", icon: "tag" },
    ],
  },
  {
    label: "Iklan",
    items: [
      { href: "/iklan", label: "Performa", icon: "ad" },
      { href: "/tracking", label: "Tracking", icon: "shield" },
      { href: "/roi", label: "ROI", icon: "wallet" },
      { href: "/radar", label: "Radar", icon: "search", superadmin: true },
    ],
  },
  {
    label: "Lead",
    items: [
      { href: "/leads", label: "Pipeline", icon: "inbox" },
      { href: "/laporan", label: "Laporan", icon: "mail" },
    ],
  },
  {
    label: "Sistem",
    items: [
      { href: "/sistem", label: "Cara Kerja", icon: "rocket" },
      { href: "/ai", label: "AI Search", icon: "sparkles" },
      { href: "/hq", label: "HQ", icon: "building", superadmin: true },
      { href: "/health", label: "Health", icon: "heart", superadmin: true },
    ],
  },
];

const iconPaths: Record<string, string> = {
  home: "M3 12 12 4l9 8M5 10v10h4v-6h6v6h4V10",
  chart: "M4 19V5m0 14h16M8 15l3-3 3 3 5-5",
  trophy: "M8 4h8v3a4 4 0 1 1-8 0V4ZM5 4H4v2a3 3 0 0 0 3 3M19 4h1v2a3 3 0 0 1-3 3M10 14h4v3l-1 3h-2l-1-3zM9 21h6",
  doc: "M7 3h7l5 5v13H7zM14 3v6h5",
  tag: "M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9zM7 8h.01",
  ad: "M3 11l16-7v16L3 13zM11 19l9 2-3-9",
  wallet: "M3 7h15a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 9V7a2 2 0 0 1 2-2h12M17 14h.01",
  search: "M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14m5 12 4 4",
  inbox: "M3 13h4l2 3h6l2-3h4M5 5h14l2 8v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6z",
  mail: "M3 7h18v12H3zM3 7l9 7 9-7",
  sparkles: "M12 3v6m0 6v6M3 12h6m6 0h6M6 6l3 3m6 6 3 3M6 18l3-3m6-6 3-3",
  building: "M4 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16M4 21h16M8 9h.01M12 9h.01M8 13h.01M12 13h.01M16 9h2v6h-2z",
  heart: "M12 21s-7-4.5-7-11a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 6.5-7 11-7 11z",
};

const isActive = (href: string) => current === href || (href !== "/" && current.startsWith(href + "/"));
const visible = (g: Group) => g.items.filter((it) => !it.superadmin || user?.role === "superadmin");
---
<!-- DESKTOP: dark charcoal sidebar -->
<aside class="sticky top-0 hidden h-screen w-[232px] shrink-0 flex-col lg:flex" style="background:#14100E;color:#fff">
  <div class="hazard-stripe w-full"></div>
  <a href="/" class="flex items-center gap-2.5 px-4 pt-4 pb-3">
    <span class="grid h-9 w-9 place-items-center rounded-lg bg-[color:var(--brand)] font-[family-name:var(--font-display)] text-base font-extrabold text-white shadow-[0_4px_14px_-2px_rgb(220_38_38_/_0.55)]">B</span>
    <span class="flex flex-col leading-tight">
      <span class="font-[family-name:var(--font-heading)] text-[15px] font-extrabold tracking-tight text-white">Beriklan</span>
      <span class="text-[10px] font-medium uppercase tracking-[0.14em] text-white/45">{tenantName}</span>
    </span>
  </a>

  <nav class="flex-1 overflow-y-auto px-2.5 py-1.5">
    {groups.map((g) => visible(g).length > 0 && (
      <div class="mb-3">
        <div class="px-3 pb-1 pt-2.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-white/35">{g.label}</div>
        <ul class="space-y-0.5">
          {visible(g).map((it) => {
            const active = isActive(it.href);
            return (
              <li>
                <a
                  href={it.href}
                  class:list={[
                    "flex items-center gap-2.5 rounded-lg px-3 py-[7px] text-[13px] transition-all duration-150",
                    active
                      ? "bg-[color:var(--brand)] font-bold text-white shadow-[0_4px_12px_-2px_rgb(220_38_38_/_0.6)]"
                      : "text-white/65 hover:bg-white/8 hover:text-white",
                  ]}
                >
                  <svg class="h-[15px] w-[15px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d={iconPaths[it.icon]} />
                  </svg>
                  <span class="truncate">{it.label}</span>
                  {it.href === "/leads" && alertCount > 0 && (
                    <span class="ml-auto grid h-4 min-w-[16px] place-items-center rounded-full bg-[#FACC15] px-1 text-[9px] font-bold text-[#1C1917]">{alertCount}</span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>

  <div class="border-t border-white/10 px-2.5 py-2.5">
    <button id="theme-toggle" class="flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-xs text-white/60 hover:bg-white/8" aria-label="Toggle theme">
      <span class="flex items-center gap-2">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <span id="theme-label">Mode</span>
      </span>
      <span class="text-[10px] text-white/35">gelap / terang</span>
    </button>
    {user ? (
      <div class="mt-1.5 flex items-center gap-2 rounded-lg bg-white/5 px-2 py-1.5">
        <div class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-[color:var(--brand)] text-[10px] font-bold text-white">{(user.email[0] ?? "?").toUpperCase()}</div>
        <div class="min-w-0 flex-1">
          <div class="truncate text-[11px] font-semibold text-white/85">{user.email}</div>
          <div class="text-[10px] text-white/40">{user.role}</div>
        </div>
        <form method="post" action="/api/auth/logout">
          <button class="grid h-6 min-w-6 place-items-center rounded-md px-1.5 text-[11px] text-white/40 hover:text-white" title="Keluar">↪</button>
        </form>
      </div>
    ) : (
      <a href="/login" class="btn btn-primary mt-1 w-full justify-center text-xs">Masuk</a>
    )}
  </div>
</aside>

<!-- MOBILE drawer -->
<div id="drawer-backdrop" class="fixed inset-0 z-40 hidden bg-black/55 backdrop-blur-[2px] lg:hidden"></div>
<aside id="mobile-drawer" class="fixed inset-y-0 left-0 z-50 flex w-[272px] -translate-x-full flex-col transition-transform duration-300 lg:hidden" style="background:#14100E;color:#fff" aria-hidden="true">
  <div class="hazard-stripe w-full"></div>
  <div class="flex items-center justify-between px-4 pt-4 pb-3">
    <a href="/" class="flex items-center gap-2.5">
      <span class="grid h-9 w-9 place-items-center rounded-lg bg-[color:var(--brand)] font-[family-name:var(--font-display)] text-base font-extrabold text-white">B</span>
      <span class="flex flex-col leading-tight">
        <span class="font-[family-name:var(--font-heading)] text-[15px] font-extrabold tracking-tight text-white">Beriklan</span>
        <span class="text-[10px] font-medium uppercase tracking-[0.14em] text-white/45">{tenantName}</span>
      </span>
    </a>
    <button id="drawer-close" class="grid h-8 w-8 place-items-center rounded-lg text-white/60 hover:bg-white/10 hover:text-white" aria-label="Tutup menu">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <nav class="flex-1 overflow-y-auto px-2.5 py-1.5">
    {groups.map((g) => visible(g).length > 0 && (
      <div class="mb-3">
        <div class="px-3 pb-1 pt-2.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-white/35">{g.label}</div>
        <ul class="space-y-0.5">
          {visible(g).map((it) => {
            const active = isActive(it.href);
            return (
              <li>
                <a
                  href={it.href}
                  class:list={[
                    "flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition-all",
                    active ? "bg-[color:var(--brand)] font-bold text-white" : "text-white/65 hover:bg-white/8 hover:text-white",
                  ]}
                >
                  <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d={iconPaths[it.icon]} />
                  </svg>
                  <span class="truncate">{it.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
  <div class="border-t border-white/10 p-3 text-[11px] text-white/40">
    {user ? user.email : <a href="/login" class="font-semibold text-white">Masuk →</a>}
  </div>
</aside>

<script is:inline>
  (() => {
    const KEY = "beriklan-theme";
    const root = document.documentElement;
    const set = (mode) => {
      root.classList.toggle("dark", mode === "dark");
      const btn = document.getElementById("theme-label");
      if (btn) btn.textContent = mode === "dark" ? "Mode Gelap" : "Mode Terang";
    };
    const saved = localStorage.getItem(KEY);
    if (saved) set(saved);
    else set(matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const next = root.classList.contains("dark") ? "light" : "dark";
      localStorage.setItem(KEY, next);
      set(next);
    });
    const drawer = document.getElementById("mobile-drawer");
    const backdrop = document.getElementById("drawer-backdrop");
    const open = () => {
      drawer?.classList.remove("-translate-x-full");
      drawer?.setAttribute("aria-hidden", "false");
      backdrop?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      drawer?.classList.add("-translate-x-full");
      drawer?.setAttribute("aria-hidden", "true");
      backdrop?.classList.add("hidden");
      document.body.style.overflow = "";
    };
    document.getElementById("menu-btn")?.addEventListener("click", open);
    document.getElementById("drawer-close")?.addEventListener("click", close);
    backdrop?.addEventListener("click", close);
  })();
</script>
