---
interface Group { label: string; items: { href: string; label: string; icon: string; superadmin?: boolean }[]; }
interface Props {
  current: string;
  user: { email: string; role: string } | null;
  tenantName: string;
  alertCount?: number;
}
const { current, user, tenantName, alertCount = 0 } = Astro.props;

const groups: Group[] = [
  {
    label: "Ringkasan",
    items: [
      { href: "/", label: "Pagi ini", icon: "home" },
    ],
  },
  {
    label: "SEO",
    items: [
      { href: "/seo", label: "Performa", icon: "chart" },
      { href: "/ranking", label: "Ranking", icon: "trophy" },
      { href: "/konten", label: "Konten", icon: "doc" },
      { href: "/keywords", label: "Keyword", icon: "tag" },
    ],
  },
  {
    label: "Iklan",
    items: [
      { href: "/iklan", label: "Performa", icon: "ad" },
      { href: "/roi", label: "ROI", icon: "wallet" },
    ],
  },
  {
    label: "Lead",
    items: [
      { href: "/leads", label: "Pipeline", icon: "inbox" },
      { href: "/laporan", label: "Laporan", icon: "mail" },
    ],
  },
  {
    label: "Sistem",
    items: [
      { href: "/ai", label: "AI Search", icon: "sparkles" },
      { href: "/hq", label: "HQ", icon: "building", superadmin: true },
      { href: "/health", label: "Health", icon: "heart", superadmin: true },
    ],
  },
];

const iconPaths: Record<string, string> = {
  home: "M3 12 12 4l9 8M5 10v10h4v-6h6v6h4V10",
  chart: "M4 19V5m0 14h16M8 15l3-3 3 3 5-5",
  trophy: "M8 4h8v3a4 4 0 1 1-8 0V4ZM5 4H4v2a3 3 0 0 0 3 3M19 4h1v2a3 3 0 0 1-3 3M10 14h4v3l-1 3h-2l-1-3zM9 21h6",
  doc: "M7 3h7l5 5v13H7zM14 3v6h5",
  tag: "M3 12V5a2 2 0 0 1 2-2h7l9 9-9 9zM7 8h.01",
  ad: "M3 11l16-7v16L3 13zM11 19l9 2-3-9",
  wallet: "M3 7h15a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 9V7a2 2 0 0 1 2-2h12M17 14h.01",
  inbox: "M3 13h4l2 3h6l2-3h4M5 5h14l2 8v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6z",
  mail: "M3 7h18v12H3zM3 7l9 7 9-7",
  sparkles: "M12 3v6m0 6v6M3 12h6m6 0h6M6 6l3 3m6 6 3 3M6 18l3-3m6-6 3-3",
  building: "M4 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16M4 21h16M8 9h.01M12 9h.01M8 13h.01M12 13h.01M16 9h2v6h-2z",
  heart: "M12 21s-7-4.5-7-11a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 6.5-7 11-7 11z",
};
---
<aside class="sidebar-shell sticky top-0 hidden h-screen w-[252px] shrink-0 flex-col border-r border-[color:var(--border-subtle)] bg-[color:var(--bg-sidebar)] lg:flex">
  <div class="hazard-stripe w-full"></div>
  <a href="/" class="flex items-center gap-2.5 px-5 pt-5 pb-3">
    <span class="grid h-9 w-9 place-items-center rounded-lg bg-[color:var(--brand)] font-[family-name:var(--font-display)] text-base font-extrabold text-white shadow-[0_4px_14px_-2px_rgb(220_38_38_/_0.45)]">B</span>
    <span class="flex flex-col leading-tight">
      <span class="font-[family-name:var(--font-heading)] text-[15px] font-extrabold tracking-tight">Beriklan</span>
      <span class="text-[10px] font-medium uppercase tracking-[0.14em] text-[color:var(--text-faint)]">{tenantName}</span>
    </span>
  </a>

  <nav class="flex-1 overflow-y-auto px-3 py-2">
    {groups.map((g) => (
      <div class="mb-4">
        <div class="px-3 pb-1.5 pt-3 text-[10px] font-semibold uppercase tracking-[0.14em] text-[color:var(--text-faint)]">{g.label}</div>
        <ul class="space-y-0.5">
          {g.items.filter((it) => !it.superadmin || user?.role === "superadmin").map((it) => {
            const active = current === it.href || (it.href !== "/" && current.startsWith(it.href + "/"));
            return (
              <li>
                <a
                  href={it.href}
                  class:list={[
                    "group relative flex items-center gap-2.5 rounded-lg px-3 py-1.5 text-sm transition-all duration-200",
                    active
                      ? "bg-[color:var(--brand-soft)] font-semibold text-[color:var(--brand)]"
                      : "text-[color:var(--text-secondary)] hover:bg-[color:var(--bg-surface-2)] hover:text-[color:var(--text-primary)]",
                  ]}
                  style={active ? "transform: translateX(2px)" : ""}
                >
                  {active && <span class="absolute left-0 top-1/2 h-4 w-0.5 -translate-y-1/2 rounded-r-full bg-[color:var(--brand)]"></span>}
                  <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d={iconPaths[it.icon]} />
                  </svg>
                  <span class="truncate">{it.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>

  <div class="border-t border-[color:var(--border-subtle)] px-3 py-3">
    <button id="theme-toggle" class="btn btn-ghost w-full justify-between text-xs" aria-label="Toggle theme">
      <span class="flex items-center gap-2">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <span id="theme-label">Mode</span>
      </span>
      <span class="text-[10px] text-[color:var(--text-faint)]">dark / light</span>
    </button>
    {user ? (
      <div class="mt-2 flex items-center gap-2 rounded-lg px-2 py-1.5">
        <div class="grid h-7 w-7 place-items-center rounded-full bg-[color:var(--bg-surface-2)] text-[10px] font-bold text-[color:var(--text-secondary)]">{(user.email[0] ?? "?").toUpperCase()}</div>
        <div class="min-w-0 flex-1">
          <div class="truncate text-[11px] font-semibold">{user.email}</div>
          <div class="text-[10px] text-[color:var(--text-faint)]">{user.role}</div>
        </div>
        <form method="post" action="/api/auth/logout">
          <button class="rounded-md px-1.5 py-0.5 text-[10px] text-[color:var(--text-faint)] hover:text-[color:var(--brand)]" title="Keluar">↪</button>
        </form>
      </div>
    ) : (
      <a href="/login" class="btn btn-primary mt-1 w-full justify-center text-xs">Masuk</a>
    )}
  </div>
</aside>

<script is:inline>
  (() => {
    const KEY = "beriklan-theme";
    const root = document.documentElement;
    const set = (mode) => {
      root.classList.toggle("dark", mode === "dark");
      const btn = document.getElementById("theme-label");
      if (btn) btn.textContent = mode === "dark" ? "Mode Gelap" : "Mode Terang";
    };
    const saved = localStorage.getItem(KEY);
    if (saved) set(saved);
    else set(matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const next = root.classList.contains("dark") ? "light" : "dark";
      localStorage.setItem(KEY, next);
      set(next);
    });
  })();
</script>
