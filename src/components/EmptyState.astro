---
// Pola 3-baris konsisten S2:
//   - apa yang kosong
//   - kenapa & kapan akan terisi
//   - aksi yang bisa dilakukan SEKARANG
interface Props {
  title: string;
  message?: string;
  mascot?: "wave" | "peek" | "sad" | "search" | "thumbs" | "lost" | "clock" | "doc";
  ctaLabel?: string;
  ctaHref?: string;
  ctaExternal?: boolean;
  when?: string;          // baris ke-2: "Akan terisi awal bulan depan" / "Menunggu OAuth Google Business Profile (±2 menit)"
  action?: string;        // baris ke-3: label aksi opsional kedua (mis. "Pelajari di /seo →")
}
const { title, message, mascot = "peek", ctaLabel, ctaHref, ctaExternal, when, action } = Astro.props;
const poses: Record<string, string> = {
  // Maskot poses — DNA Seni Patah-hati agen dashboard
  wave: "M8 12V7c0-1 .5-2 1.5-2s1.5 1 1.5 2v5m0-3c0-1 .5-2 1.5-2s1.5 1 1.5 2v5c0 1-1 2-2 2H8",
  peek: "M9 9h.01M15 9h.01M8 14c1.5 1.5 6.5 1.5 8 0",
  sad: "M9 9h.01M15 9h.01M8 16c1.5-1.5 6.5-1.5 8 0",
  search: "M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14m5 12 4 4",
  thumbs: "M7 11v9H4v-9zM7 11l4-7c1 0 2 1 2 2v3h5a2 2 0 0 1 2 2l-2 7c-.4 1-1 2-2 2H7z",
  lost: "M9 9h.01M15 9h.01M8 14c1.5 1.5 6.5 1.5 8 0M12 4c4 0 7 3 7 7s-3 7-7 7",
  clock: "M12 8v4l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z",
  doc: "M7 3h7l5 5v13H7zM14 3v6h5",
};
---
<div class="card flex flex-col items-center px-6 py-10 text-center">
  <div class="mb-4 grid h-16 w-16 place-items-center rounded-full bg-[color:var(--brand-soft)] text-[color:var(--brand)]">
    <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={poses[mascot]} /></svg>
  </div>
  <h3 class="font-[family-name:var(--font-heading)] text-base font-bold">{title}</h3>
  {message && <p class="mt-1 max-w-md text-sm text-[color:var(--text-muted)]">{message}</p>}
  {when && (
    <p class="mt-3 max-w-md text-xs text-[color:var(--text-faint)]">
      <span class="font-semibold text-[color:var(--text-secondary)]">Akan terisi</span> &middot; {when}
    </p>
  )}
  {action && (
    <p class="mt-2 max-w-md text-xs text-[color:var(--text-faint)]">
      <span class="font-semibold text-[color:var(--text-secondary)]">Sekarang bisa</span> &middot; {action}
    </p>
  )}
  {ctaLabel && ctaHref && (
    <a
      href={ctaHref}
      class="btn btn-primary mt-4"
      {...(ctaExternal ? { target: "_blank", rel: "noreferrer" } : {})}
    >
      {ctaLabel}
      {ctaExternal && (
        <svg class="ml-1 h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
      )}
    </a>
  )}
</div>
