---
import "@fontsource-variable/manrope";
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/inter";
import "@fontsource/geist-mono";
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
const user = Astro.locals.user;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Beriklan Agency</title>
    <meta name="description" content="Dashboard performa SEO, iklan & lead — Beriklan Agency." />
    <meta name="theme-color" content="#DC2626" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23DC2626'/%3E%3Cpath d='M10 8h8v3.5h-4.2v2.6H17v3.4h-3.2v2.7H18V24h-8z' fill='white'/%3E%3Crect x='20' y='8' width='2.4' height='16' fill='%23FACC15'/%3E%3C/svg%3E"
    />
  </head>
  <body class="font-body bg-slate-50 text-slate-900 antialiased">
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 font-heading text-sm font-extrabold text-white shadow-sm shadow-brand-600/30">B</span>
          <span class="font-heading text-base font-extrabold tracking-tight">
            Beriklan <span class="font-semibold text-slate-400">Dashboard</span>
          </span>
        </a>
        <nav class="hidden items-center gap-1 text-sm md:flex">
          <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/">Pagi ini</a>
          <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/seo">SEO</a>
          <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/ranking">Ranking</a>
          <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/konten">Konten</a>
          <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/leads">Leads</a>
          <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/laporan">Laporan</a>
          <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/iklan">Iklan</a>
          <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/roi">ROI</a>
          <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/keywords">Keyword</a>
          {user?.role === "superadmin" && <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/hq">HQ</a>}
          <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/ai">AI</a>
          {user?.role === "superadmin" && <a class="rounded-lg px-3 py-1.5 hover:bg-slate-100" href="/health">Health</a>}
        </nav>
        <nav class="flex items-center gap-3 text-sm">
          {user ? (
            <>
              <span class="hidden text-slate-500 sm:inline">{user.email} · {user.role}</span>
              <form method="post" action="/api/auth/logout">
                <button class="rounded-lg border border-slate-200 px-3 py-1.5 hover:bg-slate-100" type="submit">Keluar</button>
              </form>
            </>
          ) : (
            <a class="rounded-lg bg-brand-600 px-3 py-1.5 font-semibold text-white" href="/login">Masuk</a>
          )}
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
    <footer class="mx-auto max-w-5xl px-4 pb-8 text-xs text-slate-400">
      <span class="font-semibold text-slate-500">Beriklan Agency</span> · laporan otomatis tiap pagi · sgb.beriklan.co.id
    </footer>
  </body>
</html>
