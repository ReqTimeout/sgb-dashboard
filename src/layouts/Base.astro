---
import "@fontsource-variable/manrope";
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/inter";
import "@fontsource/geist-mono";
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import CommandPalette from "../components/CommandPalette.svelte";
import NotifBell from "../components/NotifBell.svelte";
import { Toaster } from "svelte-sonner";

interface Props {
  title: string;
  tenantName?: string;
  alertCount?: number;
  bare?: boolean;
}
const { title, tenantName = "Sari Glass Bangunan", alertCount = 0, bare = false } = Astro.props;
const user = Astro.locals.user;
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Dashboard performa SEO, iklan & lead — Beriklan Agency." />
    <meta name="theme-color" content="#DC2626" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23DC2626'/%3E%3Cpath d='M10 8h8v3.5h-4.2v2.6H17v3.4h-3.2v2.7H18V24h-8z' fill='white'/%3E%3Crect x='20' y='8' width='2.4' height='16' fill='%23FACC15'/%3E%3C/svg%3E"
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem("beriklan-theme");
        if (saved === "dark") document.documentElement.classList.add("dark");
        else if (saved === null && matchMedia("(prefers-color-scheme: dark)").matches) document.documentElement.classList.add("dark");
      } catch (e) {}
    </script>
    <title>{title} · Beriklan Agency</title>
  </head>
  <body class="bg-[color:var(--bg-canvas)] text-[color:var(--text-primary)]">
    {bare ? (
      <slot />
    ) : (
    <div class="flex min-h-screen">
      <Sidebar current={current} user={user ? { email: user.email, role: user.role } : null} tenantName={tenantName} alertCount={alertCount} />

      <main class="flex-1 min-w-0">
        <header class="sticky top-0 z-30 flex items-center justify-between gap-2 border-b border-[color:var(--border-subtle)] bg-[color:var(--bg-canvas)]/85 px-3 py-2.5 backdrop-blur-md sm:px-5">
          <div class="flex min-w-0 items-center gap-2">
            <button id="menu-btn" class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-[color:var(--border-default)] lg:hidden" aria-label="Buka menu">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
            <div class="min-w-0">
              <h1 class="font-[family-name:var(--font-heading)] text-[15px] font-bold leading-none tracking-tight">{title}</h1>
              <p class="mt-0.5 truncate text-[11px] text-[color:var(--text-faint)]">Data otomatis tiap pagi · {tenantName}</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <CommandPalette client:load role={user?.role ?? "viewer"} />
            <NotifBell client:load />
          </div>
        </header>

        <div class="mx-auto max-w-6xl px-3 py-4 sm:px-5">
          <slot />
        </div>

        <footer class="mx-auto max-w-6xl px-4 pb-10 pt-4 text-[11px] text-[color:var(--text-faint)] sm:px-5">
          <span class="font-semibold text-[color:var(--text-secondary)]">Beriklan Agency</span>
          · laporan otomatis tiap pagi ·
          <a href="/" class="hover:text-[color:var(--brand)]">sgb.beriklan.co.id</a>
        </footer>
      </main>
    </div>

    <Toaster richColors closeButton position="bottom-right" />
    )}
  </body>
</html>
